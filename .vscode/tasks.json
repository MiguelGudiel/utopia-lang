{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "winArch",
      "type": "pickString",
      "description": "Arquitectura objetivo para Windows",
      "options": [
        "x64",
        "ARM64",
        "Win32"
      ],
      "default": "x64"
    },
    {
      "id": "macArch",
      "type": "pickString",
      "description": "Arquitectura objetivo para macOS (arm64 = M1/M2/M3, x86_64 = Intel)",
      "options": [
        "arm64",
        "x86_64",
        "x86_64;arm64"
      ],
      "default": "arm64"
    }
  ],
  "tasks": [
    {
      "label": "build-compiler-cpp",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build",
        "--parallel"
      ],
      "group": {
        "kind": "build",
        "default": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Compila el código fuente del compilador (C++)"
    },
    {
      "label": "compile-utopia-file",
      "type": "shell",
      "command": "${workspaceFolder}/build/tools/utopia/utopia",
      "args": [
        "${file}",
        "-O0"
      ],
      "dependsOn": "build-compiler-cpp",
      "group": "build",
      "problemMatcher": [],
      "detail": "Compila el archivo .utp actual usando el binario utopia"
    },
    {
      "label": "Package Installer: Windows (NSIS)",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/scripts/build_installer.py",
        "--arch",
        "${input:winArch}"
      ],
      "windows": {},
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Package Installer: macOS (DMG)",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/build_installer.py",
        "--arch",
        "${input:macArch}"
      ],
      "osx": {},
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Package Installer: Fedora/Linux (RPM)",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/build_installer.py"
      ],
      "linux": {},
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}