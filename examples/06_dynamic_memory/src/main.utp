/*
 * Demonstrates dynamic memory allocation for arrays.
 * Shows how to allocate, initialize, read, and safely free memory.
 */
int main() {
  int size = 5;
  
  /* Allocate a dynamic array of integers on the heap */
  int* arr = new int[size];
  
  /* Initialize the array elements */
  for (int i = 0; i < size; i++) {
    arr[i] = (i + 1) * 10;
  }
  
  /* Read and print the array elements */
  for (int i = 0; i < size; i++) {
    print("Element at index %d is: %d\n", i, arr[i]);
  }
  
  /* Prevent memory leaks by freeing the allocated array */
  delete[] arr;
  
  return 0;
}