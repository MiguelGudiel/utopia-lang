force_inline int computeFastHash(int val) {
    return (val * 13) + 7;
}

int main() {
    print("Testing Break, Continue and Inline");
    
    for (int i = 0; i < 10; i = i + 1) {
        if (i == 3) {
            continue; // Skip printing 3
        }
        if (i == 7) {
            break;    // Abort loop
        }
        
        int hash = computeFastHash(i);
        print("Val: ", i, " Hash: ", hash);
    }
    
    return 0;
}