
class Person {
  String name = "José";

  Person(String name) {
    this.name = name;
  }
  
  ~Person () {
    print("Good bye.");
  }

  inline void Greet() {
    print("Hello, my name is ", name);
  }
}

int main() {
  Person* instance = new Person("XD");

  //instance.name = "Michael";
  instance.Greet();

  delete instance;
  return 0;
}