// File: examples/helloworld/src/main2.utp

class EventSystem {
    static void handleEvent(int eventType, void* data) {
        if (eventType == 1) {
            int* score = data as int*;
            print("Score actualizado: ", *score);
        } 
        else if (eventType == 2) {
            float* speed = data as float*;
            print("Velocidad detectada: ", *speed);
        }
    }
}

void main() {
    int points = 100;
    float velocity = 88.5;

    EventSystem.handleEvent(1, &points);
    EventSystem.handleEvent(2, &velocity);

    void* buffer = &points as void*; 
    int* recovered = buffer as int*;
    
    print("Valor recuperado: ", *recovered);

}