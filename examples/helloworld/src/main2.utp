// Dispatcher de eventos genérico
class EventSystem {
    // Recibe un puntero a cualquier cosa (Type Erasure)
    static void handleEvent(int eventType, void* data) {
        if (eventType == 1) {
            // Cast de void* a int*
            int* score = int*(data);
            print("Score actualizado: ", *score);
        } 
        else if (eventType == 2) {
            // Cast de void* a float*
            float* speed = float*(data);
            print("Velocidad detectada: ", *speed);
        }

        // int value = *data; 
    }
}

void main() {
    int points = 100;
    float velocity = 88.5;

    //  Decaimiento implícito (int* -> void*)
    EventSystem.handleEvent(1, &points);

    // Decaimiento implícito (float* -> void*)
    EventSystem.handleEvent(2, &velocity);

    void* buffer = void*(&points); // Forzamos a void*
    int* recovered = int*(buffer); // Recuperamos como int*
    
    print("Valor recuperado: ", *recovered);
}