import "IDrawable.utp";
import "Entity.utp";

char* msg = "¡Hello World!";

struct Vec3 {
  float x;
  float y;
  float z;
}

class Circle extends Entity implements IDrawable {
  float radius;
  Circle(this.radius, this.name) {
  }

  void Draw() {
    print(this.name, ":D");
  }

  @override 
  void Update() {
    super.Update();
    print("Circle updated", name);
  }

  inline float GetRadius() const {
    return this.radius;
  }
}

// esto hace una suma chingona
inline int sum(int a, int b) {
  return a + b;
}

int main() {
  char* msg2 = "Mamaguebo, digo glu glu glu";
  Vec3 vec3;
  vec3.x = 10;
  vec3.y = 20.0;
  vec3.z = 30;
  print(msg);
  print(msg2);
  print("Vec3(", vec3.x, ", ", vec3.y, ", ", vec3.z, ");");

  sum(1, 2);

  Circle* c = new Circle(10.0, "Circle XD");
  c.Draw();
  c.Update();

  int matrix[3][3];

  for (int i = 0; i < 3; i++) {
    for (int j = 0; j < 3; j++) {
      matrix[i][j] = i + j;
    }
  }

  int total = matrix[0][0] + matrix[1][1] + matrix[2][2];

  print("La suma de la diagonal es:");
  print(total);

  float radius = c.GetRadius();
  print(radius);
  return 0;
}
