import "utopia:test";

struct Vector3 {
    float32 x;
    float32 y;
    float32 z;
}

class SpatialNode {
    Vector3 position;
    Vector3 rotation;
    uint32 nodeId;
    bool isActive;

    SpatialNode(uint32 id) {
        nodeId = id;
        
        position.x = 0.0f;
        position.y = 0.0f;
        position.z = 0.0f;
    }

    ~SpatialNode() {
        isActive = false;
    }

    void applyVelocity(float32 vx, float32 vy, float32 vz, float32 deltaTime) {
        /* Euler integration */
        position.x = position.x + (vx * deltaTime);
        position.y = position.y + (vy * deltaTime);
        position.z = position.z + (vz * deltaTime);
    }
}

annotation class AnnExample {
    const AnnExample() {
        int64 val = 0;
    }
}

int main() {
    char letter = 'A';
    char newline = '\n';
    char tab = '\t';

    rune emoji = U'🚀';
    rune kanji = U'字';

    char* greeting = "Hello from Utopia!";

    Vector3 gravity;
    gravity.x = 0.0f;
    gravity.y = -9.81f;
    gravity.z = 0.0f;

    SpatialNode player = SpatialNode(100);
    player.applyVelocity(15.5f, gravity.y, 0.0f, 0.016f);

    int status = sum(1, 2);
    return status;
}