/*
 * Represents a 2D coordinate point.
 * Demonstrates object-oriented programming: classes, constructors, and methods.
 */
class Point {
  public int x;
  public int y;

  public Point(int x, int y) {
    this.x = x;
    this.y = y;
  }

  public void printPoint() {
    print("Point(%d, %d)\n", this.x, this.y);
  }
}

int main() {
  /* Heap allocation is explicit: `new` returns a pointer the caller owns. */
  Point* p1 = new Point(10, 20);

  /* Member access through '.' on a pointer auto-dereferences the target. */
  p1.printPoint();

  delete p1;

  return 0;
}