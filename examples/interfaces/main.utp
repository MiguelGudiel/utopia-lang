class Drawable {
    void draw();
}

class Circle implements Drawable {
    float radius;

    // Constructor con asignación directa (this.radius)
    Circle(this.radius) {}

    // Si no implementas esto, el Sema te lanzará un: 
    // "fails to implement interface 'Drawable'. Missing method 'draw'."
    void draw() {
        print("Drawing a circle with radius:", radius);
    }
}

extension IntMath on int {
    // Zero-cost: el inliner de LLVM pegará este valor donde se use
    force_inline int max() {
        return 2147483647; // 2^31 - 1
    }

    force_inline bool isEven() {
        return (this % 2) == 0;
    }
}

int main() {
    Circle c = Circle(5.5);
    c.draw();

    if (42.isEven()) {
        print("Es par");
    }
    
    int limit = int.max();

    print(limit);
    return 0;
}