import "../String.utp";

/* The C library's standard error stream, used by Console.error/errorLine. */
@extern("stderr")
void* _c_stderr;

class Console {
  @extern("printf")
  private static int32 c_printf(const uint8* format, ...);

  @extern("fprintf")
  private static int32 c_fprintf(void* stream, const uint8* format, ...);

  @extern("getchar")
  private static int32 c_getchar();

  static void print(const String& text) {
    Console.c_printf("%s", text.c_str());
  }

  static void printLine(const String& text) {
    Console.c_printf("%s\n", text.c_str());
  }

  /* Writes 'text' to standard error without a newline. */
  static void error(const String& text) {
    Console.c_fprintf(_c_stderr, "%s", text.c_str());
  }

  /* Writes 'text' followed by a newline to standard error. */
  static void errorLine(const String& text) {
    Console.c_fprintf(_c_stderr, "%s\n", text.c_str());
  }

  static String readLine() {
    String result;
    while (true) {
      int32 c = Console.c_getchar();

      /* Break on EOF (-1) or newline */
      if (c == -1 || c == 10) {
        break;
      }

      /* Ignore carriage return */
      if (c != 13) {
        result.push_back(c as uint8);
      }
    }
    return result;
  }

  static void clear() {
    Console.print("\x1B[H\x1B[2J\x1B[3J");
  }
}

/* Retained for backward compatibility */
@extern("printf")
int32 print(const uint8* format, ...);