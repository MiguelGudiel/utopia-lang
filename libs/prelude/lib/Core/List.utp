import "../Memory/Core.utp";
export "ListLiteralView.utp";

/*
 * List<T> is a growable array with std::vector-style semantics: raw aligned
 * storage is allocated with alloc() and elements are constructed lazily,
 * so no element is ever default-constructed unless it is actually stored.
 * Reallocation moves elements (Memory.construct on the new block, destruct
 * on the old), which for types with move constructors (e.g. String) is a
 * pointer steal with no per-element allocation.
 */
/*
 * ListIterator<T> — the for-in cursor of List<T>: a tiny value type holding
 * the element base pointer, the next offset and the length. It is returned
 * by value; with @inline the iteration is a raw pointer walk. Inserting
 * into the list while iterating invalidates the cursor (reallocation moves
 * the elements).
 */
class ListIterator<T> {
  T* _base;
  usize _offset;
  usize _length;

  ListIterator() {
    this._base = null;
    this._offset = 0;
    this._length = 0;
  }

  ListIterator(List<T>* list) {
    this._base = list._elem(0);
    this._offset = 0;
    this._length = list._length;
  }

  /* Advances to the next element; returns false once the list is
   * exhausted. */
  @inline
  bool moveNext() {
    if (this._offset >= this._length) return false;
    this._offset++;
    return true;
  }

  /* The current element, valid after a successful moveNext(). */
  @inline
  T& current() {
    return this._base[this._offset - 1];
  }
}


class List<T> {
  RawMemory _raw;
  usize _length;
  usize _capacity;

  List() {
    this._raw.ptr = null;
    this._length = 0;
    this._capacity = 0;
  }

  List(ListLiteralView<T> view) {
    this._raw.ptr = null;
    this._length = 0;
    this._capacity = 0;
    this._reserve(view.length);
    for (usize i = 0; i < view.length; i++) {
      _construct<T>(this._raw.ptr + i * sizeof(T), view.data[i]);
    }
    this._length = view.length;
  }

  List(const List<T>& other) {
    this._raw.ptr = null;
    this._length = 0;
    this._capacity = 0;
    this._reserve(other._length);
    for (usize i = 0; i < other._length; i++) {
      _construct<T>(this._raw.ptr + i * sizeof(T),
                   ((other._raw.ptr + i * sizeof(T)) as T*)[0]);
    }
    this._length = other._length;
  }

  ~List() {
    if (this._raw.ptr != null) {
      for (usize i = 0; i < this._length; i++) {
        destruct(this._elem(i));
      }
      free(this._raw);
    }
  }

  void operator=(const List<T>& other) {
    if (this == &other) return;
    if (this._raw.ptr != null) {
      for (usize i = 0; i < this._length; i++) {
        destruct(this._elem(i));
      }
    }
    this._length = 0;
    this._reserve(other._length);
    for (usize i = 0; i < other._length; i++) {
      _construct<T>(this._raw.ptr + i * sizeof(T),
                   ((other._raw.ptr + i * sizeof(T)) as T*)[0]);
    }
    this._length = other._length;
  }

  void operator=(ListLiteralView<T> view) {
    if (this._raw.ptr != null) {
      for (usize i = 0; i < this._length; i++) {
        destruct(this._elem(i));
      }
    }
    this._length = 0;
    this._reserve(view.length);
    for (usize i = 0; i < view.length; i++) {
      _construct<T>(this._raw.ptr + i * sizeof(T), view.data[i]);
    }
    this._length = view.length;
  }

  /* Typed pointer to element 'i'. */
  @inline
  T* _elem(usize i) {
    return (this._raw.ptr + i * sizeof(T)) as T*;
  }

  /* Grows the storage to hold at least 'minCap' elements, moving the live
   * elements into the new block. */
  void _reserve(usize minCap) {
    if (minCap <= this._capacity) return;
    usize newCap = this._capacity == 0 ? 8 as usize : this._capacity;
    while (newCap < minCap) {
      newCap = newCap * 2;
    }
    RawMemory newRaw = alloc(newCap * sizeof(T), alignof(T));
    for (usize i = 0; i < this._length; i++) {
      _construct<T>(newRaw.ptr + i * sizeof(T), this._elem(i)[0] as T&&);
    }
    for (usize i = 0; i < this._length; i++) {
      destruct(this._elem(i));
    }
    free(this._raw);
    this._raw = newRaw;
    this._capacity = newCap;
  }

  usize length() {
    return this._length;
  }

  usize capacity() {
    return this._capacity;
  }

  /* Appends 'value'. The element is move-constructed from the parameter
   * when T has a move constructor, otherwise copy-constructed. */
  void push(T value) {
    if (this._length >= this._capacity) {
      this._reserve(this._length + 1);
    }
    _construct<T>(this._raw.ptr + this._length * sizeof(T), value as T&&);
    this._length++;
  }

  @inline
  T& operator[](usize index) {
    return this._elem(index)[0];
  }

  /* Dart-style aliases and collection helpers.
   *
   * Methods that copy or compare T values are declared with a dummy type
   * parameter so their bodies are only checked when actually called: this
   * keeps List<T> instantiable for any T (like Future<void>), mirroring
   * C++'s lazy member instantiation. The dummy binds to the record's own
   * type argument, so call sites look normal: list.sort(), list.join(", ").
   */

  void add<T2>(T value) {
    this.push(value);
  }

  void addAll<T2>(const List<T>& other) {
    for (usize i = 0; i < other._length; i++) {
      this.push(((other._raw.ptr + i * sizeof(T)) as T*)[0]);
    }
  }

  /* List-literal overload (Dart: list.addAll([...])). */
  void addAll<T2>(ListLiteralView<T> view) {
    for (usize i = 0; i < view.length; i++) {
      this.push(view.data[i]);
    }
  }

  @inline
  bool isEmpty() {
    return this._length == 0;
  }

  @inline
  bool isNotEmpty() {
    return this._length != 0;
  }

  /* Destructs the live elements and resets the length; the capacity is
   * kept for reuse. */
  void clear() {
    for (usize i = 0; i < this._length; i++) {
      destruct(this._elem(i));
    }
    this._length = 0;
  }

  /* True when 'value' is present (uses operator== on T). The dummy type
   * parameter defers the check until the method is actually called, so
   * List<T> stays instantiable for types without operator==. */
  bool contains<T2>(T value) {
    for (usize i = 0; i < this._length; i++) {
      if (this._elem(i)[0] == value) return true;
    }
    return false;
  }

  /* Index of the first occurrence of 'value', or -1 when absent. */
  int64 indexOf<T2>(T value) {
    for (usize i = 0; i < this._length; i++) {
      if (this._elem(i)[0] == value) return i as int64;
    }
    return -1;
  }

  /* Index of the last occurrence of 'value', or -1 when absent. */
  int64 lastIndexOf<T2>(T value) {
    for (int64 i = (this._length - 1) as int64; i >= 0; i--) {
      if (this._elem(i as usize)[0] == value) return i;
    }
    return -1;
  }

  @inline
  T& first() {
    return this._elem(0)[0];
  }

  @inline
  T& last() {
    return this._elem(this._length - 1)[0];
  }

  /* Inserts 'value' at 'index', shifting the following elements right. */
  void insert(usize index, T value) {
    if (index > this._length) index = this._length;
    if (this._length >= this._capacity) {
      this._reserve(this._length + 1);
    }
    for (usize i = this._length; i > index; i--) {
      _construct<T>(this._elem(i), this._elem(i - 1)[0] as T&&);
      destruct(this._elem(i - 1));
    }
    _construct<T>(this._elem(index), value as T&&);
    this._length++;
  }

  /* Removes and returns the element at 'index'. The element is moved out,
   * so the return is a move for move-constructible T. */
  T removeAt<T2>(usize index) {
    T removed = this._elem(index)[0] as T&&;
    for (usize i = index; i + 1 < this._length; i++) {
      _construct<T>(this._elem(i), this._elem(i + 1)[0] as T&&);
      destruct(this._elem(i + 1));
    }
    this._length--;
    return removed;
  }

  /* Removes the first occurrence of 'value'; returns whether one was
   * removed. */
  bool remove<T2>(T value) {
    for (usize i = 0; i < this._length; i++) {
      if (this._elem(i)[0] == value) {
        this.removeAt(i);
        return true;
      }
    }
    return false;
  }

  /* A new list holding the elements in [start, end). */
  List<T> sublist<T2>(usize start, usize end) {
    List<T> result;
    if (start >= end || start >= this._length) return result;
    if (end > this._length) end = this._length;
    for (usize i = start; i < end; i++) {
      result.push(this._elem(i)[0]);
    }
    return result;
  }

  /* Concatenates the elements' string forms with 'separator' between them.
   * T must be convertible to String. */
  String join<T2>(String separator) {
    String result;
    for (usize i = 0; i < this._length; i++) {
      if (i > 0) {
        result = result + separator;
      }
      result = result + String(this._elem(i)[0]);
    }
    return result;
  }

  /* Runs 'fn' for every element, in order. */
  void forEach<T2>(void Function(T) fn) {
    for (usize i = 0; i < this._length; i++) {
      fn(this._elem(i)[0]);
    }
  }

  /* A new list with the result of applying 'fn' to every element. */
  List<T2> map<T2>(T2 Function(T) fn) {
    List<T2> result;
    for (usize i = 0; i < this._length; i++) {
      result.push(fn(this._elem(i)[0]));
    }
    return result;
  }

  /* A new list with only the elements for which 'fn' returns true. */
  List<T> where<T2>(bool Function(T) fn) {
    List<T> result;
    for (usize i = 0; i < this._length; i++) {
      if (fn(this._elem(i)[0])) {
        result.push(this._elem(i)[0]);
      }
    }
    return result;
  }

  /* Combines the elements with 'fn', from first to last. The first element
   * is returned as-is (Dart reduce semantics). */
  T reduce<T2>(T Function(T, T) fn) {
    T acc = this._elem(0)[0] as T&&;
    for (usize i = 1; i < this._length; i++) {
      acc = fn(acc, this._elem(i)[0]);
    }
    return acc;
  }

  /* Sorts in place using operator< on T (stable insertion sort). Shifts
   * are moves: the element is move-constructed into its new slot and the
   * old slot is destructed, so types with move constructors avoid
   * reallocation entirely. */
  void sort<T2>() {
    for (usize i = 1; i < this._length; i++) {
      T key = this._elem(i)[0] as T&&;
      int64 j = (i - 1) as int64;
      while (j >= 0 && key < this._elem(j as usize)[0]) {
        _construct<T>(this._elem((j + 1) as usize),
                     this._elem(j as usize)[0] as T&&);
        destruct(this._elem(j as usize));
        j--;
      }
      _construct<T>(this._elem((j + 1) as usize), key as T&&);
    }
  }

  /* Sorts in place with an explicit comparator ('less' must return true when
   * its first argument should come before the second). */
  void sort<T2>(bool Function(T, T) less) {
    for (usize i = 1; i < this._length; i++) {
      T key = this._elem(i)[0] as T&&;
      int64 j = (i - 1) as int64;
      while (j >= 0 && less(key, this._elem(j as usize)[0])) {
        _construct<T>(this._elem((j + 1) as usize),
                     this._elem(j as usize)[0] as T&&);
        destruct(this._elem(j as usize));
        j--;
      }
      _construct<T>(this._elem((j + 1) as usize), key as T&&);
    }
  }

  /* for-in support ('for (var x in list)'): a zero-cost cursor over the raw
   * element storage, in order. moveNext()/current() are @inline, so the
   * whole loop compiles to the same machine code as a manual index walk —
   * no Iterable hierarchy, no vtables, no allocation. */
  @inline
  ListIterator<T> iterator() {
    return ListIterator<T>(this);
  }
}

