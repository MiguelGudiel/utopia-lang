import "../Memory/Core.utp";
export "ListLiteralView.utp";

/*
 * List<T> is a growable array with std::vector-style semantics: raw aligned
 * storage is allocated with alloc() and elements are constructed lazily,
 * so no element is ever default-constructed unless it is actually stored.
 * Reallocation moves elements (Memory.construct on the new block, destruct
 * on the old), which for types with move constructors (e.g. String) is a
 * pointer steal with no per-element allocation.
 */
/*
 * ListIterator<T>: the for-in cursor of List<T>, a tiny value type holding
 * the element base pointer, the next offset and the length. It is returned
 * by value; with @inline the iteration is a raw pointer walk. Inserting
 * into the list while iterating invalidates the cursor (reallocation moves
 * the elements).
 */
class ListIterator<T> {
  T* _base;
  usize _offset;
  usize _length;

  ListIterator() {
    this._base = null;
    this._offset = 0;
    this._length = 0;
  }

  ListIterator(List<T>* list) {
    this._base = list._elem(0);
    this._offset = 0;
    this._length = list._length;
  }

  /* Advances to the next element; returns false once the list is
   * exhausted. */
  @inline
  bool moveNext() {
    if (this._offset >= this._length) return false;
    this._offset++;
    return true;
  }

  /* The current element, valid after a successful moveNext(). */
  @inline
  T& current() {
    return this._base[this._offset - 1];
  }
}


class List<T> {
  RawMemory _raw;
  usize _length;
  usize _capacity;

  List() {
    this._raw.ptr = null;
    this._length = 0;
    this._capacity = 0;
  }

  List(ListLiteralView<T> view) {
    this._raw.ptr = null;
    this._length = 0;
    this._capacity = 0;
    this._reserve(view.length);
    for (usize i = 0; i < view.length; i++) {
      _construct<T>(this._raw.ptr + i * sizeof(T), view.data[i]);
    }
    this._length = view.length;
  }

  List(const List<T>& other) {
    this._raw.ptr = null;
    this._length = 0;
    this._capacity = 0;
    this._reserve(other._length);
    for (usize i = 0; i < other._length; i++) {
      _construct<T>(this._raw.ptr + i * sizeof(T),
                   ((other._raw.ptr + i * sizeof(T)) as T*)[0]);
    }
    this._length = other._length;
  }

  ~List() {
    if (this._raw.ptr != null) {
      for (usize i = 0; i < this._length; i++) {
        destruct(this._elem(i));
      }
      free(this._raw);
    }
  }

  void operator=(const List<T>& other) {
    if (this == &other) return;
    if (this._raw.ptr != null) {
      for (usize i = 0; i < this._length; i++) {
        destruct(this._elem(i));
      }
    }
    this._length = 0;
    this._reserve(other._length);
    for (usize i = 0; i < other._length; i++) {
      _construct<T>(this._raw.ptr + i * sizeof(T),
                   ((other._raw.ptr + i * sizeof(T)) as T*)[0]);
    }
    this._length = other._length;
  }

  void operator=(ListLiteralView<T> view) {
    if (this._raw.ptr != null) {
      for (usize i = 0; i < this._length; i++) {
        destruct(this._elem(i));
      }
    }
    this._length = 0;
    this._reserve(view.length);
    for (usize i = 0; i < view.length; i++) {
      _construct<T>(this._raw.ptr + i * sizeof(T), view.data[i]);
    }
    this._length = view.length;
  }

  /* Typed pointer to element 'i'. */
  @inline
  T* _elem(usize i) {
    return (this._raw.ptr + i * sizeof(T)) as T*;
  }

  /* Grows the storage to hold at least 'minCap' elements, moving the live
   * elements into the new block. */
  void _reserve(usize minCap) {
    if (minCap <= this._capacity) return;
    usize newCap = this._capacity == 0 ? 8 as usize : this._capacity;
    while (newCap < minCap) {
      newCap = newCap * 2;
    }
    RawMemory newRaw = alloc(newCap * sizeof(T), alignof(T));
    for (usize i = 0; i < this._length; i++) {
      _construct<T>(newRaw.ptr + i * sizeof(T), this._elem(i)[0] as T&&);
    }
    for (usize i = 0; i < this._length; i++) {
      destruct(this._elem(i));
    }
    free(this._raw);
    this._raw = newRaw;
    this._capacity = newCap;
  }

  usize length() {
    return this._length;
  }

  usize capacity() {
    return this._capacity;
  }

  /* Appends 'value'. The element is move-constructed from the parameter
   * when T has a move constructor, otherwise copy-constructed. */
  void push(T value) {
    if (this._length >= this._capacity) {
      this._reserve(this._length + 1);
    }
    _construct<T>(this._raw.ptr + this._length * sizeof(T), value as T&&);
    this._length++;
  }

  @inline
  T& operator[](usize index) {
    return this._elem(index)[0];
  }

  /* Dart-style aliases and collection helpers.
   *
   * Methods that copy or compare T values are declared with a dummy type
   * parameter so their bodies are only checked when actually called: this
   * keeps List<T> instantiable for any T (like Future<void>), mirroring
   * C++'s lazy member instantiation. The dummy binds to the record's own
   * type argument, so call sites look normal: list.sort(), list.join(", ").
   */

  void add<T2>(T value) {
    this.push(value);
  }

  void addAll<T2>(const List<T>& other) {
    for (usize i = 0; i < other._length; i++) {
      this.push(((other._raw.ptr + i * sizeof(T)) as T*)[0]);
    }
  }

  /* List-literal overload (Dart: list.addAll([...])). */
  void addAll<T2>(ListLiteralView<T> view) {
    for (usize i = 0; i < view.length; i++) {
      this.push(view.data[i]);
    }
  }

  @inline
  bool isEmpty() {
    return this._length == 0;
  }

  @inline
  bool isNotEmpty() {
    return this._length != 0;
  }

  /* Destructs the live elements and resets the length; the capacity is
   * kept for reuse. */
  void clear() {
    for (usize i = 0; i < this._length; i++) {
      destruct(this._elem(i));
    }
    this._length = 0;
  }

  /* True when 'value' is present (uses operator== on T). The dummy type
   * parameter defers the check until the method is actually called, so
   * List<T> stays instantiable for types without operator==. */
  bool contains<T2>(T value) {
    for (usize i = 0; i < this._length; i++) {
      if (this._elem(i)[0] == value) return true;
    }
    return false;
  }

  /* Index of the first occurrence of 'value', or -1 when absent. */
  int64 indexOf<T2>(T value) {
    for (usize i = 0; i < this._length; i++) {
      if (this._elem(i)[0] == value) return i as int64;
    }
    return -1;
  }

  /* Index of the last occurrence of 'value', or -1 when absent. */
  int64 lastIndexOf<T2>(T value) {
    for (int64 i = (this._length - 1) as int64; i >= 0; i--) {
      if (this._elem(i as usize)[0] == value) return i;
    }
    return -1;
  }

  @inline
  T& first() {
    return this._elem(0)[0];
  }

  @inline
  T& last() {
    return this._elem(this._length - 1)[0];
  }

  /* Inserts 'value' at 'index', shifting the following elements right. */
  void insert(usize index, T value) {
    if (index > this._length) index = this._length;
    if (this._length >= this._capacity) {
      this._reserve(this._length + 1);
    }
    for (usize i = this._length; i > index; i--) {
      _construct<T>(this._elem(i), this._elem(i - 1)[0] as T&&);
      destruct(this._elem(i - 1));
    }
    _construct<T>(this._elem(index), value as T&&);
    this._length++;
  }

  /* Removes and returns the element at 'index'. The element is moved out,
   * so the return is a move for move-constructible T. */
  T removeAt<T2>(usize index) {
    T removed = this._elem(index)[0] as T&&;
    for (usize i = index; i + 1 < this._length; i++) {
      _construct<T>(this._elem(i), this._elem(i + 1)[0] as T&&);
      destruct(this._elem(i + 1));
    }
    this._length--;
    return removed;
  }

  /* Removes the first occurrence of 'value'; returns whether one was
   * removed. */
  bool remove<T2>(T value) {
    for (usize i = 0; i < this._length; i++) {
      if (this._elem(i)[0] == value) {
        this.removeAt(i);
        return true;
      }
    }
    return false;
  }

  /* A new list holding the elements in [start, end). */
  List<T> sublist<T2>(usize start, usize end) {
    List<T> result;
    if (start >= end || start >= this._length) return result;
    if (end > this._length) end = this._length;
    for (usize i = start; i < end; i++) {
      result.push(this._elem(i)[0]);
    }
    return result;
  }

  /* Concatenates the elements' string forms with 'separator' between them.
   * T must be convertible to String. */
  String join<T2>(String separator) {
    String result;
    for (usize i = 0; i < this._length; i++) {
      if (i > 0) {
        result = result + separator;
      }
      result = result + String(this._elem(i)[0]);
    }
    return result;
  }

  /* Runs 'fn' for every element, in order. */
  void forEach<T2>(void Function(T) fn) {
    for (usize i = 0; i < this._length; i++) {
      fn(this._elem(i)[0]);
    }
  }

  /* A new list with the result of applying 'fn' to every element. */
  List<T2> map<T2>(T2 Function(T) fn) {
    List<T2> result;
    for (usize i = 0; i < this._length; i++) {
      result.push(fn(this._elem(i)[0]));
    }
    return result;
  }

  /* A new list with only the elements for which 'fn' returns true. */
  List<T> where<T2>(bool Function(T) fn) {
    List<T> result;
    for (usize i = 0; i < this._length; i++) {
      if (fn(this._elem(i)[0])) {
        result.push(this._elem(i)[0]);
      }
    }
    return result;
  }

  /* Combines the elements with 'fn', from first to last. The first element
   * is returned as-is (Dart reduce semantics). */
  T reduce<T2>(T Function(T, T) fn) {
    T acc = this._elem(0)[0] as T&&;
    for (usize i = 1; i < this._length; i++) {
      acc = fn(acc, this._elem(i)[0]);
    }
    return acc;
  }

  /* Sorts in place using operator< on T. Stable bottom-up merge sort,
   * O(n log n): the elements are moved into a temporary buffer of the
   * list's size and merged back, so move-constructible T (e.g. String)
   * never copies. The temp buffer is allocated per call.
   *
   * The comparison lives in _mergeRunsCmp (not in a lambda here) so the
   * operator< requirement only surfaces when this overload is actually
   * called: sorting with an explicit comparator must work for types
   * without operator<. */
  void sort<T2>() {
    this._mergeSortCmp(this._length);
  }

  /* Sorts in place with an explicit comparator ('less' must return true
   * when its first argument should come before the second). Stable
   * bottom-up merge sort, O(n log n). */
  void sort<T2>(bool Function(T, T) less) {
    this._mergeSortLess(this._length, less);
  }

  void _mergeSortCmp<T2>(usize n) {
    usize width = 1;
    while (width < n) {
      for (usize lo = 0; lo < n; lo += width * 2) {
        usize mid = lo + width;
        if (mid >= n) break;
        usize hi = lo + width * 2;
        if (hi > n) hi = n;
        this._mergeRunsCmp(lo, mid, hi);
      }
      width *= 2;
    }
  }

  /* Merges two adjacent runs, ordering with operator< on T. The dummy
   * template parameter defers the body check until sort() actually runs,
   * so instantiating List<T> for a type without operator< (e.g. a nested
   * List<List<int>>) does not fail. */
  void _mergeRunsCmp<T2>(usize lo, usize mid, usize hi) {
    RawMemory tmp = alloc((hi - lo) * sizeof(T), alignof(T));
    for (usize i = lo; i < hi; i++) {
      _construct<T>(tmp.ptr + (i - lo) * sizeof(T), this._elem(i)[0] as T&&);
      destruct(this._elem(i));
    }
    usize i = 0;
    usize j = mid - lo;
    usize end = hi - lo;
    usize n1 = mid - lo;
    usize k = lo;
    while (i < n1 && j < end) {
      T* a = (tmp.ptr + i * sizeof(T)) as T*;
      T* b = (tmp.ptr + j * sizeof(T)) as T*;
      if (b[0] < a[0]) {
        _construct<T>(this._elem(k), b[0] as T&&);
        destruct(b);
        j++;
      } else {
        _construct<T>(this._elem(k), a[0] as T&&);
        destruct(a);
        i++;
      }
      k++;
    }
    while (i < n1) {
      T* a = (tmp.ptr + i * sizeof(T)) as T*;
      _construct<T>(this._elem(k), a[0] as T&&);
      destruct(a);
      i++;
      k++;
    }
    while (j < end) {
      T* b = (tmp.ptr + j * sizeof(T)) as T*;
      _construct<T>(this._elem(k), b[0] as T&&);
      destruct(b);
      j++;
      k++;
    }
    free(tmp);
  }

  /* Iterative bottom-up merge sort over [0, n): doubles the run length
   * each pass, merging adjacent runs. */
  void _mergeSortLess(usize n, bool Function(T, T) less) {
    usize width = 1;
    while (width < n) {
      for (usize lo = 0; lo < n; lo += width * 2) {
        usize mid = lo + width;
        if (mid >= n) break;
        usize hi = lo + width * 2;
        if (hi > n) hi = n;
        this._mergeRuns(lo, mid, hi, less);
      }
      width *= 2;
    }
  }

  /* Merges the two adjacent runs [lo, mid) and [mid, hi) into a
   * temporary buffer and back. */
  void _mergeRuns(usize lo, usize mid, usize hi,
                  bool Function(T, T) less) {
    RawMemory tmp = alloc((hi - lo) * sizeof(T), alignof(T));
    for (usize i = lo; i < hi; i++) {
      _construct<T>(tmp.ptr + (i - lo) * sizeof(T), this._elem(i)[0] as T&&);
      destruct(this._elem(i));
    }
    usize i = 0;
    usize j = mid - lo;
    usize end = hi - lo;
    usize n1 = mid - lo;
    usize k = lo;
    while (i < n1 && j < end) {
      T* a = (tmp.ptr + i * sizeof(T)) as T*;
      T* b = (tmp.ptr + j * sizeof(T)) as T*;
      if (less(b[0], a[0])) {
        _construct<T>(this._elem(k), b[0] as T&&);
        destruct(b);
        j++;
      } else {
        _construct<T>(this._elem(k), a[0] as T&&);
        destruct(a);
        i++;
      }
      k++;
    }
    while (i < n1) {
      T* a = (tmp.ptr + i * sizeof(T)) as T*;
      _construct<T>(this._elem(k), a[0] as T&&);
      destruct(a);
      i++;
      k++;
    }
    while (j < end) {
      T* b = (tmp.ptr + j * sizeof(T)) as T*;
      _construct<T>(this._elem(k), b[0] as T&&);
      destruct(b);
      j++;
      k++;
    }
    free(tmp);
  }

  /* Index of 'value' in a list sorted with sort() (operator< ordering),
   * or -1 when absent. O(log n) comparisons. */
  int64 binarySearch<T2>(T value) {
    usize lo = 0;
    usize hi = this._length;
    while (lo < hi) {
      usize mid = lo + (hi - lo) / 2;
      if (this._elem(mid)[0] < value) {
        lo = mid + 1;
      } else {
        hi = mid;
      }
    }
    if (lo < this._length && !(value < this._elem(lo)[0]) &&
        !(this._elem(lo)[0] < value)) {
      return lo as int64;
    }
    return -1;
  }

  /* True when 'fn' returns true for at least one element. */
  bool any<T2>(bool Function(T) fn) {
    for (usize i = 0; i < this._length; i++) {
      if (fn(this._elem(i)[0])) return true;
    }
    return false;
  }

  /* True when 'fn' returns true for every element. */
  bool every<T2>(bool Function(T) fn) {
    for (usize i = 0; i < this._length; i++) {
      if (!fn(this._elem(i)[0])) return false;
    }
    return true;
  }

  /* Combines the elements with 'combine' starting from 'initialValue'
   * (left fold). */
  T fold<T2>(T initialValue, T Function(T, T) combine) {
    T acc = initialValue;
    for (usize i = 0; i < this._length; i++) {
      acc = combine(acc, this._elem(i)[0]);
    }
    return acc;
  }

  /* A new list with the elements of the lists returned by 'fn', in
   * order. */
  List<R> expand<R>(List<R> Function(T) fn) {
    List<R> result;
    for (usize i = 0; i < this._length; i++) {
      List<R> part = fn(this._elem(i)[0]);
      for (usize j = 0; j < part.length(); j++) {
        result.push(part[j]);
      }
    }
    return result;
  }

  /* The first 'count' elements (fewer when the list is shorter). */
  List<T> take<T2>(usize count) {
    if (count > this._length) count = this._length;
    return this.sublist(0, count);
  }

  /* Everything after the first 'count' elements. */
  List<T> skip<T2>(usize count) {
    if (count > this._length) count = this._length;
    return this.sublist(count, this._length);
  }

  /* Finds the first element for which 'fn' is true; 'out' receives it and
   * the method returns true, or false when none matches. */
  bool firstWhere<T2>(bool Function(T) fn, T& out) {
    for (usize i = 0; i < this._length; i++) {
      if (fn(this._elem(i)[0])) {
        out = this._elem(i)[0];
        return true;
      }
    }
    return false;
  }

  /* Removes every element for which 'fn' returns true; returns the number
   * of elements removed. */
  usize removeWhere<T2>(bool Function(T) fn) {
    usize removed = 0;
    usize i = 0;
    while (i < this._length) {
      if (fn(this._elem(i)[0])) {
        this.removeAt(i);
        removed++;
      } else {
        i++;
      }
    }
    return removed;
  }

  /* Reorders the elements uniformly at random (Fisher-Yates with an
   * internal xorshift64* generator seeded from the clock, so no stdlib
   * dependency). */
  void shuffle<T2>() {
    uint64 state = List._randomSeed();
    for (int64 i = (this._length - 1) as int64; i > 0; i--) {
      state = List._nextRandom(state);
      usize j = (state % ((i + 1) as uint64)) as usize;
      T tmp = this._elem(i as usize)[0];
      this._elem(i as usize)[0] = this._elem(j)[0];
      this._elem(j)[0] = tmp;
    }
  }

  /* C's time(time_t*) writes through its pointer argument; the declaration
   * must carry the parameter or the leftover register value (e.g. 'this')
   * is used as the destination and clobbered. */
  @extern("time")
  private static int64 _clock(int64* t);

  private static uint64 _randomSeed() {
    uint64 t = List._clock(null) as uint64;
    return t * 0x9E3779B97F4A7C15 + 0x9E3779B97F4A7C15;
  }

  private static uint64 _nextRandom(uint64 state) {
    state = state * 0x2545F4914F6CDD1D;
    return state ^ (state >> 33);
  }

  /* A new list keeping only the first occurrence of each element
   * (operator== on T; O(n^2) scan). */
  List<T> distinct<T2>() {
    List<T> result;
    for (usize i = 0; i < this._length; i++) {
      T v = this._elem(i)[0];
      if (!result.contains(v)) {
        result.push(v);
      }
    }
    return result;
  }

  /* A list of 'count' elements built by calling 'fn' with each index. */
  static List<E> generate<E>(usize count, E Function(usize) fn) {
    List<E> result;
    result._reserve(count);
    for (usize i = 0; i < count; i++) {
      result.push(fn(i));
    }
    return result;
  }

  /* A list of 'count' copies of 'value'. */
  static List<E> filled<E>(usize count, E value) {
    List<E> result;
    result._reserve(count);
    for (usize i = 0; i < count; i++) {
      result.push(value);
    }
    return result;
  }

  /* A list holding the elements of 'view' (a list literal). */
  static List<E> of<E>(ListLiteralView<E> view) {
    List<E> result;
    result._reserve(view.length);
    for (usize i = 0; i < view.length; i++) {
      result.push(view.data[i]);
    }
    return result;
  }

  /* for-in support ('for (var x in list)'): a zero-cost cursor over the raw
   * element storage, in order. moveNext()/current() are @inline, so the
   * whole loop compiles to the same machine code as a manual index walk,
   * with no Iterable hierarchy, no vtables and no allocation. */
  @inline
  ListIterator<T> iterator() {
    return ListIterator<T>(this);
  }
}

