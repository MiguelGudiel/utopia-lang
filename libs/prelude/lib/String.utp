import "Core/List.utp";

class String {
  private uint8* data;
  private usize len;
  private usize cap;

  /* Internal utilities for memory and string length evaluation to avoid 
     heavy external dependencies inside the prelude. */
  private static usize c_strlen(const uint8* str) {
    if (str == null)
      return 0;
    usize i = 0;
    while (str[i] != 0) {
      i++;
    }
    return i;
  }

  private static void c_strcpy(uint8* dest, const uint8* src, usize length) {
    for (usize i = 0; i < length; i++) {
      dest[i] = src[i];
    }
    dest[length] = 0;
  }

  /* Bytes of the UTF-8 sequence starting with leading byte 'b' (1 for
   * ASCII and for invalid leading bytes). */
  private static usize utf8CharLen(uint8 b) {
    if (b < 0x80) return 1;
    if ((b & 0xE0) == 0xC0) return 2;
    if ((b & 0xF0) == 0xE0) return 3;
    if ((b & 0xF8) == 0xF0) return 4;
    return 1;
  }

  /* Decodes the UTF-8 codepoint starting at byte 'pos' and stores the
   * position of the next codepoint in 'next'. Invalid sequences decode
   * byte-by-byte (each byte yields itself), so malformed input never
   * crashes and round-trips losslessly. */
  private static int32 utf8Decode(const uint8* data, usize pos, usize end,
                                  usize& next) {
    uint8 b0 = data[pos];
    usize clen = String.utf8CharLen(b0);
    if (pos + clen > end) clen = 1;
    if (clen == 1) {
      next = pos + 1;
      return b0;
    }
    int32 cp = (b0 & (0x7F >> clen)) as int32;
    for (usize i = 1; i < clen; i++) {
      uint8 b = data[pos + i];
      if ((b & 0xC0) != 0x80) {
        next = pos + 1;
        return b0;
      }
      cp = (cp << 6) | (b & 0x3F);
    }
    next = pos + clen;
    return cp;
  }

  /* Encodes 'cp' as UTF-8 into 'buf' (which must hold at least 4 bytes)
   * and returns the number of bytes written. */
  private static usize utf8Encode(uint8* buf, int32 cp) {
    if (cp < 0x80) {
      buf[0] = cp as uint8;
      return 1;
    }
    if (cp < 0x800) {
      buf[0] = (0xC0 | (cp >> 6)) as uint8;
      buf[1] = (0x80 | (cp & 0x3F)) as uint8;
      return 2;
    }
    if (cp < 0x10000) {
      buf[0] = (0xE0 | (cp >> 12)) as uint8;
      buf[1] = (0x80 | ((cp >> 6) & 0x3F)) as uint8;
      buf[2] = (0x80 | (cp & 0x3F)) as uint8;
      return 3;
    }
    buf[0] = (0xF0 | (cp >> 18)) as uint8;
    buf[1] = (0x80 | ((cp >> 12) & 0x3F)) as uint8;
    buf[2] = (0x80 | ((cp >> 6) & 0x3F)) as uint8;
    buf[3] = (0x80 | (cp & 0x3F)) as uint8;
    return 4;
  }

  /* Unicode whitespace: the ASCII set plus NEL, NBSP, OGHAM SPACE MARK,
   * the U+2000..U+200A range, line/paragraph separators, narrow NBSP,
   * medium math space and ideographic space. */
  private static bool isWhitespaceCp(int32 c) {
    return c == 32 || c == 9 || c == 10 || c == 11 || c == 12 || c == 13 ||
           c == 0x85 || c == 0xA0 || c == 0x1680 ||
           (c >= 0x2000 && c <= 0x200A) || c == 0x2028 || c == 0x2029 ||
           c == 0x202F || c == 0x205F || c == 0x3000;
  }

  /* strtoll: parses a prefix of the string; 'end' receives the position
   * after the parsed digits. base 0 auto-detects 0x/0o/0b prefixes. */
  @extern("strtoll")
  private static int64 c_strtoll(const uint8* nptr, uint8** end, int32 base);

  @extern("atoi")
  private static int32 c_atoi(const uint8* str);

  @extern("atof")
  private static float64 c_atof(const uint8* str);

  @extern("atoll")
  private static int64 c_atoll(const uint8* str);

  @extern("snprintf")
  private static int32 c_snprintf(
    uint8* str,
    usize size,
    const uint8* format,
    ...,
  );

  String() {
    this.len = 0;
    this.cap = 15;
    this.data = new uint8[16];
    this.data[0] = 0;
  }

  String(const uint8* str) {
    if (str == null) {
      this.len = 0;
      this.cap = 15;
      this.data = new uint8[16];
      this.data[0] = 0;
      return;
    }
    this.len = String.c_strlen(str);
    this.cap = this.len + 15;
    this.data = new uint8[this.cap + 1];
    String.c_strcpy(this.data, str, this.len);
  }

  String(int8 v) {
    this.cap = 15;
    this.data = new uint8[16];
    this.len = String.c_snprintf(this.data, 16, "%d", v) as usize;
  }

  String(uint8 v) {
    this.cap = 15;
    this.data = new uint8[16];
    this.len = String.c_snprintf(this.data, 16, "%u", v) as usize;
  }

  String(int16 v) {
    this.cap = 15;
    this.data = new uint8[16];
    this.len = String.c_snprintf(this.data, 16, "%d", v) as usize;
  }

  String(uint16 v) {
    this.cap = 15;
    this.data = new uint8[16];
    this.len = String.c_snprintf(this.data, 16, "%u", v) as usize;
  }

  String(int32 v) {
    this.cap = 15;
    this.data = new uint8[16];
    this.len = String.c_snprintf(this.data, 16, "%d", v) as usize;
  }

  String(uint32 v) {
    this.cap = 15;
    this.data = new uint8[16];
    this.len = String.c_snprintf(this.data, 16, "%u", v) as usize;
  }

  String(int64 v) {
    this.cap = 31;
    this.data = new uint8[32];
    /* Standard format specifier for 64-bit integer */
    this.len = String.c_snprintf(this.data, 32, "%lld", v) as usize;
  }

  String(uint64 v) {
    this.cap = 31;
    this.data = new uint8[32];
    this.len = String.c_snprintf(this.data, 32, "%llu", v) as usize;
  }

  String(usize v) {
    this.cap = 31;
    this.data = new uint8[32];
    this.len = String.c_snprintf(this.data, 32, "%llu", v) as usize;
  }

  String(float32 v) {
    this.cap = 31;
    this.data = new uint8[32];
    /* CodeGen automatically promotes variadic float32 to float64, 
     * making "%g" completely safe. */
    this.len = String.c_snprintf(this.data, 32, "%g", v) as usize;
  }

  String(float64 v) {
    this.cap = 31;
    this.data = new uint8[32];
    this.len = String.c_snprintf(this.data, 32, "%g", v) as usize;
  }

  String(bool v) {
    this.cap = 15;
    this.data = new uint8[16];
    if (v) {
      this.len = 4;
      String.c_strcpy(this.data, "true", 4);
    } else {
      this.len = 5;
      String.c_strcpy(this.data, "false", 5);
    }
  }

  String(const String& other) {
    this.len = other.len;
    this.cap = other.cap;
    this.data = new uint8[this.cap + 1];
    String.c_strcpy(this.data, other.data, this.len);
  }

  /* Move constructor: steals the source's buffer, leaving it empty.
   * Enables zero-allocation moves (e.g. List reallocation). */
  String(String&& other) {
    this.data = other.data;
    this.len = other.len;
    this.cap = other.cap;
    other.data = null;
    other.len = 0;
    other.cap = 0;
  }

  ~String() {
    if (this.data != null)
      delete[] this.data;
  }

  void operator=(const String& other) {
    if (this.data != null)
      delete[] this.data;
    this.len = other.len;
    this.cap = other.cap;
    this.data = new uint8[this.cap + 1];
    String.c_strcpy(this.data, other.data, this.len);
  }

  /* Move assignment: releases this string's buffer and steals the source's,
   * leaving it empty. */
  void operator=(String&& other) {
    if (this.data != null)
      delete[] this.data;
    this.data = other.data;
    this.len = other.len;
    this.cap = other.cap;
    other.data = null;
    other.len = 0;
    other.cap = 0;
  }

  void operator=(const uint8* str) {
    if (this.data != null)
      delete[] this.data;
    if (str == null) {
      this.len = 0;
      this.cap = 15;
      this.data = new uint8[16];
      this.data[0] = 0;
      return;
    }
    this.len = String.c_strlen(str);
    this.cap = this.len + 15;
    this.data = new uint8[this.cap + 1];
    String.c_strcpy(this.data, str, this.len);
  }

  bool operator==(const String& other) {
    if (this.len != other.len) return false;
    for (usize i = 0; i < this.len; i++) {
      if (this.data[i] != other.data[i]) return false;
    }
    return true;
  }

  bool operator==(const uint8* str) {
    if (str == null) return this.len == 0;
    usize str_len = String.c_strlen(str);
    if (this.len != str_len) return false;
    for (usize i = 0; i < this.len; i++) {
      if (this.data[i] != str[i]) return false;
    }
    return true;
  }

  bool operator!=(const String& other) {
    /* Dereference this pointer to invoke the overloaded operator== */
    return !(*this == other);
  }

  bool operator!=(const uint8* str) {
    return !(*this == str);
  }

  /* Lexicographic ordering (used by SplayTreeMap and sorting). */
  bool operator<(const String& other) {
    usize n = this.len < other.len ? this.len : other.len;
    for (usize i = 0; i < n; i++) {
      if (this.data[i] < other.data[i]) return true;
      if (this.data[i] > other.data[i]) return false;
    }
    return this.len < other.len;
  }

  bool operator>(const String& other) {
    return other < *this;
  }

  bool operator<=(const String& other) {
    return !(other < *this);
  }

  bool operator>=(const String& other) {
    return !(*this < other);
  }

  String operator+(const String& other) {
    String result;
    result.len = this.len + other.len;
    result.cap = result.len + 15;

    delete[] result.data;
    result.data = new uint8[result.cap + 1];

    String.c_strcpy(result.data, this.data, this.len);
    for (usize i = 0; i < other.len; i++) {
      result.data[this.len + i] = other.data[i];
    }
    result.data[result.len] = 0;

    return result;
  }

  String operator+(const uint8* str) {
    String result;
    if (str == null) {
      result = *this;
      return result;
    }

    usize str_len = String.c_strlen(str);
    result.len = this.len + str_len;
    result.cap = result.len + 15;

    delete[] result.data;
    result.data = new uint8[result.cap + 1];

    String.c_strcpy(result.data, this.data, this.len);
    for (usize i = 0; i < str_len; i++) {
      result.data[this.len + i] = str[i];
    }
    result.data[result.len] = 0;

    return result;
  }

  String operator+(uint8 c) {
    String result = *this;
    result.push_back(c);
    return result;
  }

  @inline
  uint8& operator[](usize index) {
    return this.data[index];
  }

  @inline
  usize length() {
    return this.len;
  }

  @inline
  usize capacity() {
    return this.cap;
  }

  @inline
  const uint8* c_str() {
    return this.data;
  }

  int32 toInt() {
    if (this.data == null) return 0;
    return String.c_atoi(this.data);
  }

  float64 toFloat() {
    if (this.data == null) return 0.0;
    return String.c_atof(this.data);
  }

  void clear() {
    this.len = 0;
    this.data[0] = 0;
  }

  void push_back(uint8 c) {
    if (this.len >= this.cap) {
      this.cap = this.cap * 2 + 15;
      uint8* new_data = new uint8[this.cap + 1];
      String.c_strcpy(new_data, this.data, this.len);
      delete[] this.data;
      this.data = new_data;
    }
    this.data[this.len] = c;
    this.len++;
    this.data[this.len] = 0;
  }

  @inline
  bool isEmpty() {
    return this.len == 0;
  }

  @inline
  bool isNotEmpty() {
    return this.len != 0;
  }

  int64 toInt64() {
    if (this.data == null) return 0;
    return String.c_atoll(this.data);
  }

  /* Returns the substring in [start, end). 'end' is exclusive, like Dart. */
  String substring(usize start, usize end) {
    String result;
    if (start >= end || start >= this.len) return result;
    if (end > this.len) end = this.len;
    for (usize i = start; i < end; i++) {
      result.push_back(this.data[i]);
    }
    return result;
  }

  bool startsWith(const String& prefix) {
    if (prefix.len > this.len) return false;
    for (usize i = 0; i < prefix.len; i++) {
      if (this.data[i] != prefix.data[i]) return false;
    }
    return true;
  }

  bool startsWith(const uint8* prefix) {
    if (prefix == null) return this.len == 0;
    usize plen = String.c_strlen(prefix);
    if (plen > this.len) return false;
    for (usize i = 0; i < plen; i++) {
      if (this.data[i] != prefix[i]) return false;
    }
    return true;
  }

  bool endsWith(const String& suffix) {
    if (suffix.len > this.len) return false;
    usize start = this.len - suffix.len;
    for (usize i = 0; i < suffix.len; i++) {
      if (this.data[start + i] != suffix.data[i]) return false;
    }
    return true;
  }

  bool contains(const String& needle) {
    return this.indexOf(needle) >= 0;
  }

  bool contains(uint8 c) {
    return this.indexOf(c) >= 0;
  }

  /* Index of the first occurrence, or -1 when absent (like Dart). */
  int64 indexOf(const String& needle) {
    if (needle.len == 0) return 0;
    if (needle.len > this.len) return -1;
    for (usize i = 0; i + needle.len <= this.len; i++) {
      usize j = 0;
      while (j < needle.len && this.data[i + j] == needle.data[j]) {
        j++;
      }
      if (j == needle.len) return i as int64;
    }
    return -1;
  }

  int64 indexOf(uint8 c) {
    for (usize i = 0; i < this.len; i++) {
      if (this.data[i] == c) return i as int64;
    }
    return -1;
  }

  /* Index of the last occurrence, or -1 when absent. */
  int64 lastIndexOf(const String& needle) {
    if (needle.len == 0) return this.len as int64;
    if (needle.len > this.len) return -1;
    for (int64 i = (this.len - needle.len) as int64; i >= 0; i--) {
      usize j = 0;
      while (j < needle.len && this.data[i as usize + j] == needle.data[j]) {
        j++;
      }
      if (j == needle.len) return i;
    }
    return -1;
  }

  int64 lastIndexOf(uint8 c) {
    for (int64 i = (this.len - 1) as int64; i >= 0; i--) {
      if (this.data[i as usize] == c) return i;
    }
    return -1;
  }

  /* Replaces every occurrence of 'from' with 'to'. */
  String replace(const String& from, const String& to) {
    String result;
    if (from.len == 0) {
      return *this;
    }
    usize i = 0;
    while (i < this.len) {
      bool matched = true;
      if (i + from.len > this.len) {
        matched = false;
      } else {
        for (usize j = 0; j < from.len; j++) {
          if (this.data[i + j] != from.data[j]) {
            matched = false;
            break;
          }
        }
      }
      if (matched) {
        for (usize j = 0; j < to.len; j++) {
          result.push_back(to.data[j]);
        }
        i += from.len;
      } else {
        result.push_back(this.data[i]);
        i++;
      }
    }
    return result;
  }

  /* Encodes one UTF-8 codepoint into 'out' (at least 8 bytes), applying
   * the multi-character case mappings (sharp s and the Latin ligatures
   * expand to multiple letters). Returns the number of bytes written. */
  private static usize appendUpper(uint8* out, int32 cp) {
    if (cp == 0xDF) {
      out[0] = 0x53;
      out[1] = 0x53;
      return 2;
    }
    if (cp == 0xFB00 || cp == 0xFB03) {
      out[0] = 0x46;
      out[1] = 0x46;
      if (cp == 0xFB03) {
        out[2] = 0x49;
        return 3;
      }
      return 2;
    }
    if (cp == 0xFB01) {
      out[0] = 0x46;
      out[1] = 0x49;
      return 2;
    }
    if (cp == 0xFB02 || cp == 0xFB04) {
      out[0] = 0x46;
      out[1] = 0x4C;
      if (cp == 0xFB04) {
        out[2] = 0x4C;
        return 3;
      }
      return 2;
    }
    if (cp == 0xFB05 || cp == 0xFB06) {
      out[0] = 0x53;
      out[1] = 0x54;
      return 2;
    }
    int32 u = String._toUpperCp(cp);
    if (u == 0) {
      return String.utf8Encode(out, cp);
    }
    return String.utf8Encode(out, u);
  }

  /* Unicode-aware uppercase: Latin-1/Extended, Greek and Cyrillic are
   * mapped by the generated tables; the sharp s and the Latin ligatures
   * expand (ß -> SS). Codepoints outside those scripts are kept as-is. */
  String toUpperCase() {
    String result;
    for (usize i = 0; i < this.len; i++) {
      usize next;
      int32 c = String.utf8Decode(this.data, i, this.len, next);
      uint8[8] buf;
      usize n = String.appendUpper(&buf[0], c);
      for (usize j = 0; j < n; j++) {
        result.push_back(buf[j]);
      }
      i = next - 1;
    }
    return result;
  }

  /* Encodes one codepoint in lowercase into 'out' (at least 8 bytes),
   * handling the dotted capital I (I -> i + combining dot above). Returns
   * the number of bytes written. */
  private static usize appendLower(uint8* out, int32 cp) {
    if (cp == 0x130) {
      out[0] = 0x69;
      out[1] = 0xCC;
      out[2] = 0x87;
      return 3;
    }
    int32 l = String._toLowerCp(cp);
    if (l == 0) {
      return String.utf8Encode(out, cp);
    }
    return String.utf8Encode(out, l);
  }

  /* Unicode-aware lowercase, mirroring toUpperCase(). */
  String toLowerCase() {
    String result;
    for (usize i = 0; i < this.len; i++) {
      usize next;
      int32 c = String.utf8Decode(this.data, i, this.len, next);
      uint8[8] buf;
      usize n = String.appendLower(&buf[0], c);
      for (usize j = 0; j < n; j++) {
        result.push_back(buf[j]);
      }
      i = next - 1;
    }
    return result;
  }

  String trim() {
    usize start = 0;
    while (start < this.len) {
      usize next;
      int32 c = String.utf8Decode(this.data, start, this.len, next);
      if (!String.isWhitespaceCp(c)) break;
      start = next;
    }
    /* Track the end of the last non-whitespace codepoint: the run after
     * it (possibly empty) is the trailing whitespace to cut. */
    usize lastEnd = start;
    usize i = start;
    while (i < this.len) {
      usize next;
      int32 c = String.utf8Decode(this.data, i, this.len, next);
      if (!String.isWhitespaceCp(c)) {
        lastEnd = next;
      }
      i = next;
    }
    return this.substring(start, lastEnd);
  }

  String trimStart() {
    usize start = 0;
    while (start < this.len) {
      usize next;
      int32 c = String.utf8Decode(this.data, start, this.len, next);
      if (!String.isWhitespaceCp(c)) break;
      start = next;
    }
    return this.substring(start, this.len);
  }

  String trimEnd() {
    usize lastEnd = 0;
    usize i = 0;
    while (i < this.len) {
      usize next;
      int32 c = String.utf8Decode(this.data, i, this.len, next);
      if (!String.isWhitespaceCp(c)) {
        lastEnd = next;
      }
      i = next;
    }
    return this.substring(0, lastEnd);
  }

  /* Splits this string on every occurrence of the delimiter. */
  List<String> split(uint8 delimiter) {
    List<String> result;
    String current;
    for (usize i = 0; i < this.len; i++) {
      if (this.data[i] == delimiter) {
        result.push(current);
        current.clear();
      } else {
        current.push_back(this.data[i]);
      }
    }
    result.push(current);
    return result;
  }

  List<String> split(const String& delimiter) {
    List<String> result;
    if (delimiter.len == 0) {
      for (usize i = 0; i < this.len; i++) {
        String piece;
        piece.push_back(this.data[i]);
        result.push(piece);
      }
      return result;
    }
    usize i = 0;
    String current;
    while (i < this.len) {
      bool matched = true;
      if (i + delimiter.len > this.len) {
        matched = false;
      } else {
        for (usize j = 0; j < delimiter.len; j++) {
          if (this.data[i + j] != delimiter.data[j]) {
            matched = false;
            break;
          }
        }
      }
      if (matched) {
        result.push(current);
        current.clear();
        i += delimiter.len;
      } else {
        current.push_back(this.data[i]);
        i++;
      }
    }
    result.push(current);
    return result;
  }

  /* printf-style formatting (String.format("%d and %s", x, s)). The
   * variadic arguments go straight to the runtime helper, which formats
   * into a last-result buffer reused by the next format call; assign the
   * result to a String (implicit copy) to take an owning copy, e.g.
   * 'String s = String.format("%d", x);'. */
  @extern("utopia_string_format")
  static const uint8* format(const uint8* fmt, ...);

  /* -- UTF-8 aware operations ---------------------------------------- */

  /* The codepoint starting at byte 'index' (0-based byte offset). */
  int32 codePointAt(usize index) {
    if (index >= this.len) return -1;
    usize next;
    return String.utf8Decode(this.data, index, this.len, next);
  }

  /* The number of UTF-8 codepoints (bytes when the string is pure ASCII). */
  usize runeCount() {
    usize count = 0;
    usize i = 0;
    while (i < this.len) {
      usize next;
      String.utf8Decode(this.data, i, this.len, next);
      count++;
      i = next;
    }
    return count;
  }

  /* All codepoints, in order. */
  List<int32> runes() {
    List<int32> result;
    usize i = 0;
    while (i < this.len) {
      usize next;
      int32 cp = String.utf8Decode(this.data, i, this.len, next);
      result.push(cp);
      i = next;
    }
    return result;
  }

  /* A string holding the single codepoint 'codePoint' as UTF-8. */
  static String fromCharCode(int32 codePoint) {
    uint8[4] buf;
    usize n = String.utf8Encode(&buf[0], codePoint);
    String result;
    for (usize i = 0; i < n; i++) {
      result.push_back(buf[i]);
    }
    return result;
  }

  /* -- padding, repetition, reversal ---------------------------------- */

  /* Pads this string on the left with 'padding' (repeated as needed) to
   * reach 'width' bytes; returns a copy when already wide enough. */
  String padLeft(usize width, const uint8* padding) {
    return this._pad(width, padding, true);
  }

  String padRight(usize width, const uint8* padding) {
    return this._pad(width, padding, false);
  }

  private String _pad(usize width, const uint8* padding, bool onLeft) {
    usize padLen = String.c_strlen(padding);
    if (this.len >= width || padLen == 0) return *this;
    usize need = width - this.len;
    String result;
    if (!onLeft) {
      for (usize i = 0; i < this.len; i++) {
        result.push_back(this.data[i]);
      }
    }
    usize done = 0;
    while (done < need) {
      for (usize i = 0; i < padLen && done < need; i++) {
        result.push_back(padding[i]);
        done++;
      }
    }
    if (onLeft) {
      for (usize i = 0; i < this.len; i++) {
        result.push_back(this.data[i]);
      }
    }
    return result;
  }

  /* This string concatenated with itself 'times' times (0 yields ""). */
  String repeat(usize times) {
    String result;
    result.len = this.len * times;
    result.cap = result.len + 15;
    delete[] result.data;
    result.data = new uint8[result.cap + 1];
    for (usize t = 0; t < times; t++) {
      for (usize i = 0; i < this.len; i++) {
        result.data[t * this.len + i] = this.data[i];
      }
    }
    result.data[result.len] = 0;
    return result;
  }

  /* The string with the codepoints in reverse order (UTF-8 safe). */
  String reversed() {
    List<int32> r = this.runes();
    String result;
    uint8[4] buf;
    for (int64 i = (r.length() - 1) as int64; i >= 0; i--) {
      usize n = String.utf8Encode(&buf[0], r[i as usize]);
      for (usize j = 0; j < n; j++) {
        result.push_back(buf[j]);
      }
    }
    return result;
  }

  /* -- parsing -------------------------------------------------------- */

  /* Parses this string as an integer in 'radix' (2..36; 0 auto-detects
   * the 0x/0o/0b prefixes and leading-0 octal). Returns 0 when no digits
   * parse. */
  int64 parse(int32 radix = 0) {
    if (radix == 0 && this.len >= 2 && this.data[0] == 48) {
      uint8 p = this.data[1];
      if (p == 0x78 || p == 0x58) { /* 0x */
        return String.c_strtoll(this.data + 2, null, 16);
      }
      if (p == 0x6F || p == 0x4F) { /* 0o */
        return String.c_strtoll(this.data + 2, null, 8);
      }
      if (p == 0x62 || p == 0x42) { /* 0b */
        return String.c_strtoll(this.data + 2, null, 2);
      }
    }
    return String.c_strtoll(this.data, null, radix);
  }

  /* Parses this string in the given radix; 'out' receives the value and
   * the method returns whether a valid integer was parsed (at least one
   * digit after an optional sign). Radix 0 auto-detects 0x/0o/0b. */
  bool tryParse(int32 radix, int64& out) {
    uint8* start = this.data;
    int32 effective = radix;
    if (radix == 0 && this.len >= 2 && this.data[0] == 48) {
      uint8 p = this.data[1];
      if (p == 0x78 || p == 0x58) { /* 0x */
        start = this.data + 2;
        effective = 16;
      } else if (p == 0x6F || p == 0x4F) { /* 0o */
        start = this.data + 2;
        effective = 8;
      } else if (p == 0x62 || p == 0x42) { /* 0b */
        start = this.data + 2;
        effective = 2;
      }
    }
    uint8* end = null;
    int64 value = String.c_strtoll(start, &end, effective);
    if (end == start) return false;
    out = value;
    return true;
  }
