/* Global operator overloads to support commutativity when primitives 
   are on the left-hand side of the expression. */

String operator+(const uint8* lhs, const String& rhs) {
  String res = lhs;
  return res + rhs;
}

String operator+(uint8 lhs, const String& rhs) {
  String res = "";
  res.push_back(lhs);
  return res + rhs;
}

@inline
bool operator==(const uint8* lhs, const String& rhs) {
  /* Reverse the operands to reuse the internal class logic */
  return rhs == lhs;
}

@inline
bool operator!=(const uint8* lhs, const String& rhs) {
  return rhs != lhs;
}

/*
 * StringBuilder: an efficiently growing byte buffer for assembling
 * strings. String concatenation (operator+) allocates a fresh buffer on
 * every operation; StringBuilder appends into one buffer that grows
 * geometrically, so building a string from many pieces is O(n) total
 * (versus O(n^2) for repeated concatenation).
 */
class StringBuilder {
  uint8* _data;
  usize _len;
  usize _cap;

  StringBuilder() {
    this._data = null;
    this._len = 0;
    this._cap = 0;
  }

  /* Preallocates 'capacity' bytes so the first appends do not reallocate. */
  StringBuilder(usize capacity) {
    this._data = null;
    this._len = 0;
    this._cap = 0;
    this._reserve(capacity);
  }

  StringBuilder(const StringBuilder& other) {
    this._data = null;
    this._len = 0;
    this._cap = 0;
    this._reserve(other._len);
    for (usize i = 0; i < other._len; i++) {
      this._data[i] = other._data[i];
    }
    this._len = other._len;
    this._data[this._len] = 0;
  }

  ~StringBuilder() {
    if (this._data != null) {
      delete[] this._data;
    }
  }

  void operator=(const StringBuilder& other) {
    if (this == &other) return;
    this._reserve(other._len);
    for (usize i = 0; i < other._len; i++) {
      this._data[i] = other._data[i];
    }
    this._len = other._len;
    this._data[this._len] = 0;
  }

  @inline
  usize length() {
    return this._len;
  }

  @inline
  bool isEmpty() {
    return this._len == 0;
  }

  @inline
  bool isNotEmpty() {
    return this._len != 0;
  }

  void _reserve(usize needed) {
    if (needed <= this._cap) return;
    usize newCap = this._cap == 0 ? (16 as usize) : this._cap * 2;
    while (newCap < needed) {
      newCap *= 2;
    }
    uint8* newData = new uint8[newCap + 1];
    for (usize i = 0; i < this._len; i++) {
      newData[i] = this._data[i];
    }
    if (this._data != null) {
      delete[] this._data;
    }
    this._data = newData;
    this._cap = newCap;
  }

  void _appendBytes(const uint8* src, usize n) {
    this._reserve(this._len + n);
    for (usize i = 0; i < n; i++) {
      this._data[this._len + i] = src[i];
    }
    this._len += n;
    this._data[this._len] = 0;
  }

  void append(const String& s) {
    this._appendBytes(s.c_str(), s.length());
  }

  void append(const uint8* str) {
    this._appendBytes(str, String.c_strlen(str));
  }

  void append(uint8 c) {
    this._reserve(this._len + 1);
    this._data[this._len] = c;
    this._len++;
    this._data[this._len] = 0;
  }

  void append(int32 v) {
    this.append(String(v));
  }

  void append(int64 v) {
    this.append(String(v));
  }

  void append(float64 v) {
    this.append(String(v));
  }

  void append(bool v) {
    this.append(String(v));
  }

  /* The accumulated text as an owning String. The builder keeps its
   * buffer and can be reused after clear(). */
  String toString() {
    return String(this._data);
  }

  void clear() {
    this._len = 0;
    if (this._data != null) {
      this._data[0] = 0;
    }
  }
}
