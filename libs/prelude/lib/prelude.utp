import "String.utp";

// Utopia Numeric Limits Prelude
// Provides named constants for the minimum and maximum values
// of all built‑in integer types.
// (Floating‑point limits require scientific‑notation support in the lexer;
//  they are commented out below for reference once that feature is available.)

// Signed 8‑bit integer
const int8 INT8_MAX = 127;
const int8 INT8_MIN = -128;

// Unsigned 8‑bit integer
const uint8 UINT8_MAX = 255;

// Signed 16‑bit integer
const int16 INT16_MAX = 32767;
const int16 INT16_MIN = -32768;

// Unsigned 16‑bit integer
const uint16 UINT16_MAX = 65535;

// Signed 32‑bit integer
const int32 INT32_MAX = 2147483647;
const int32 INT32_MIN = -2147483648;

// Unsigned 32‑bit integer
const uint32 UINT32_MAX = 4294967295;

// Signed 64‑bit integer
const int64 INT64_MAX = 9223372036854775807;
const int64 INT64_MIN = -9223372036854775808;

// Unsigned 64‑bit integer
const uint64 UINT64_MAX = 18446744073709551615;

// Floating‑point

const float32 FLOAT32_MAX = 3.40282347e+38;
const float32 FLOAT32_MIN = 1.17549435e-38;
const float64 FLOAT64_MAX = 1.7976931348623157e+308;
const float64 FLOAT64_MIN = 2.2250738585072014e-308;

// Foreign C Runtime Integration

@extern
void* malloc(uint64 size);

@extern
void free(void* ptr);

@extern("printf")
int32 print(const uint8* format, ...);

@extern
uint32 sleep(uint32 seconds);

@extern
int32 system(const uint8* command);