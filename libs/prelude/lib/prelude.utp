/* Memory/Core.utp must be parsed before Core/List.utp (and the String
 * module that imports it): its template intrinsics (construct<T>) are
 * registered at parse time, and List's body uses them.
 *
 * The prelude only keeps what virtually every program needs: dynamic
 * strings and the List/Map core, the memory model, the Console/print
 * bindings, Duration (Stopwatch/DateTime use it and live in the stdlib
 * 'time' module) and the async Future. Everything else (Math, System,
 * Random, collections, SIMD, ...) lives in the stdlib and is imported
 * explicitly with 'utopia:name'. */
export "Memory/Core.utp";
export "Core/List.utp";
export "Core/ListLiteralView.utp";
export "Core/MapLiteralView.utp";
export "String.utp";
export "Core/Duration.utp";
export "Core/Map.utp";
export "IO/Console.utp";
export "Async/Future.utp";
