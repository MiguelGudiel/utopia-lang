@extern
void* malloc(usize size);

@extern
void free(void* ptr);

/*
 * RawMemory is an untyped heap allocation returned by alloc().
 * It owns the block; release it exactly once with free().
 */
struct RawMemory {
  uint8* ptr;
}

/*
 * Allocates 'size' bytes aligned to 'align' (a power of two) without
 * constructing anything. Out-of-memory terminates the program (the same
 * policy as 'new'). The returned block is released with free().
 */
@intrinsic("memory_alloc")
RawMemory alloc(usize size, usize align);

/*
 * Releases a block previously returned by alloc().
 */
@intrinsic("memory_free")
void free(RawMemory mem);

/*
 * Constructs an object of type T in existing memory ('ptr' may be a typed
 * pointer, void*, or byte pointer such as RawMemory.ptr). Constructor
 * arguments are forwarded; the returned pointer aliases 'ptr'.
 * NOTE: the declared signature is a placeholder; the compiler intercepts
 * the call and resolves T from the explicit type argument.
 * Internal prelude name: the public API is Memory.construct (stdlib).
 */
@intrinsic("memory_construct")
public void* _construct<T>(void* ptr);

/*
 * Runs the destructor of the pointee type, if it has one. Does not free
 * the memory: pair with free() on the owning RawMemory.
 */
@intrinsic("memory_destruct")
void destruct(void* ptr);

/*
 * Returns whether 'ptr' points at a canonical const object (built at
 * compile time in static read-only storage). Such objects are immortal:
 * their destructors never run and they must never be freed. Frameworks
 * that receive objects by pointer (e.g. a UI framework handed a widget)
 * can query this before deleting: if isConst(ptr) is true, skip the
 * delete; otherwise free normally. The check is O(N) over the program's
 * const objects, which is negligible for real-world counts.
 */
@intrinsic("memory_is_const")
public bool isConst(void* ptr);

class Type {
  uint8* name;
  bool isClass;
  bool isStruct;
  bool isPrimitive;
  bool isEnum;
  bool isArray;
  bool isPointer;
}

class MethodInfo {
  uint8* name;
  uint8* mangledName;
  Type returnType;
  Type* args;
}

@intrinsic("sizeof_type")
usize sizeof(Type t);

@intrinsic("sizeof_expr")
usize sizeof<T>(T val);

@intrinsic("alignof_type")
usize alignof(Type t);

@intrinsic("alignof_expr")
usize alignof<T>(T val);

@intrinsic("typeof_type")
Type typeof(Type t);

@intrinsic("typeof_expr")
Type typeof<T>(T val);