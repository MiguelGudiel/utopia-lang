/*
 * Time measurement and calendar types (Stopwatch, DateTime). Duration lives
 * in the prelude because the async runtime's Future.delayed lowering and the
 * Stopwatch/DateTime APIs all return it.
 *
 * Stopwatch measures elapsed time with microsecond resolution.
 * One tick equals one microsecond, so
 * frequency() is 1000000 and elapsedTicks() equals elapsedMicroseconds().
 */

#if _WIN32

@extern("QueryPerformanceCounter")
private int32 _os_qpc(int64* counter);

@extern("QueryPerformanceFrequency")
private int32 _os_qpf(int64* freq);

#else

struct _Timespec {
  public int64 tv_sec;
  public int64 tv_nsec;
}

@extern("clock_gettime")
private int32 _os_clock_gettime(int32 clockid, _Timespec* tp);

#endif

/* Thrown by DateTime.parse on malformed input. */
class FormatException {}

class Stopwatch {
  private int64 _startUs;
  private int64 _stopUs;
  private bool _running;

  Stopwatch() {
    this._startUs = 0;
    this._stopUs = 0;
    this._running = false;
  }

  /* Monotonic wall clock, in microseconds. */
  static int64 _nowUs() {
    #if _WIN32
    int64 freq;
    int64 counter;
    _os_qpf(&freq);
    _os_qpc(&counter);
    return counter * 1000000 / freq;
    #else
    _Timespec ts;
    _os_clock_gettime(1, &ts); /* CLOCK_MONOTONIC */
    return ts.tv_sec * 1000000 + ts.tv_nsec / 1000;
    #endif
  }

  bool isRunning() {
    return this._running;
  }

  /* Ticks per second: one tick is one microsecond. */
  @inline
  int64 frequency() {
    return 1000000;
  }

  /* The elapsed time as a Duration. While running, this keeps advancing;
   * once stopped it is frozen at the stopped instant. */
  Duration elapsed() {
    if (this._running) {
      return Duration.microseconds(Stopwatch._nowUs() - this._startUs);
    }
    return Duration.microseconds(this._stopUs - this._startUs);
  }

  @inline
  int64 elapsedTicks() {
    return this.elapsedMicroseconds();
  }

  int64 elapsedMicroseconds() {
    return this.elapsed().inMicroseconds();
  }

  @inline
  int64 elapsedMilliseconds() {
    return this.elapsed().inMilliseconds();
  }

  /* Starts the stopwatch. No effect if it is already running. */
  void start() {
    if (!this._running) {
      this._startUs = Stopwatch._nowUs();
      this._running = true;
    }
  }

  /* Stops the stopwatch. No effect if it is not running. */
  void stop() {
    if (this._running) {
      this._stopUs = Stopwatch._nowUs();
      this._running = false;
    }
  }

  /* Resets the stopwatch to zero. If it is running, it keeps running and
   * starts counting from zero. */
  void reset() {
    int64 now = Stopwatch._nowUs();
    this._startUs = now;
    this._stopUs = now;
  }
}


/*
 * DateTime: a point in time with microsecond precision, mirroring the most
 * useful parts of Dart's dart:core DateTime API.
 *
 * Values before the epoch (negative microsecondsSinceEpoch) and UTC/local
 * conversion are supported through the platform C library.
 */

/* Mirrors the C struct tm. The trailing gmtoff/zone fields are written by
 * localtime_r on glibc/bionic and Darwin (macOS), so they are included
 * there; they back DateTime's timezone support. */
struct _Tm {
  int32 tm_sec;
  int32 tm_min;
  int32 tm_hour;
  int32 tm_mday;
  int32 tm_mon;
  int32 tm_year;
  int32 tm_wday;
  int32 tm_yday;
  int32 tm_isdst;
  #if !_WIN32
  int64 tm_gmtoff;
  uint8* tm_zone;
  #endif
}

@extern("time")
int64 _os_time(int64* t);

@extern("mktime")
int64 _os_mktime(_Tm* tm);

#if _WIN32

@extern("localtime_s")
int32 _os_localtime_s(_Tm* tm, int64* time);

@extern("gmtime_s")
int32 _os_gmtime_s(_Tm* tm, int64* time);

@extern("_mkgmtime")
int64 _os_mkgmtime(_Tm* tm);

#else

@extern("localtime_r")
_Tm* _os_localtime_r(int64* time, _Tm* tm);

@extern("gmtime_r")
_Tm* _os_gmtime_r(int64* time, _Tm* tm);

@extern("timegm")
int64 _os_timegm(_Tm* tm);

/* IANA-zone lookup for DateTime.inZone: the TZ environment variable is
 * switched to the zone for the duration of one localtime_r call (glibc
 * re-reads /usr/share/zoneinfo after tzset), so the zone's real DST rules
 * apply. The process-wide TZ is restored afterwards; this is not
 * thread-safe, so concurrent inZone calls must be serialized. */
@extern("getenv")
uint8* _tz_getenv(const uint8* name);

@extern("setenv")
int32 _tz_setenv(const uint8* name, const uint8* value, int32 overwrite);

@extern("unsetenv")
int32 _tz_unsetenv(const uint8* name);

@extern("tzset")
void _tz_tzset();

#endif


class DateTime {
  int64 _us;
  bool _utc;
  /* UTC offset in seconds east of UTC: 0 for 'Z' times, the parsed or
   * zoned offset when known, and INT32_MIN when the value is a plain
   * local time (the offset is then derived from the local zone). */
  int32 _offset;

  static const int32 OFFSET_UNSET = -2147483648;

  /* Constructs a local DateTime from calendar parts (Dart's DateTime
   * constructor). 'month' is 1-based; the remaining parts default like in
   * Dart. */
  DateTime(
    int64 year,
    int64 month = 1,
    int64 day = 1,
    int64 hour = 0,
    int64 minute = 0,
    int64 second = 0,
    int64 millisecond = 0,
    int64 microsecond = 0,
  ) {
    _Tm tm;
    tm.tm_sec = second as int32;
    tm.tm_min = minute as int32;
    tm.tm_hour = hour as int32;
    tm.tm_mday = day as int32;
    tm.tm_mon = (month - 1) as int32;
    tm.tm_year = (year - 1900) as int32;
    tm.tm_wday = 0;
    tm.tm_yday = 0;
    tm.tm_isdst = -1;
    int64 secs = _os_mktime(&tm);
    this._us = secs * 1000000 + millisecond * 1000 + microsecond;
    this._utc = false;
    this._offset = DateTime.OFFSET_UNSET;
  }

  /* Internal: builds a DateTime directly from an epoch timestamp. */
  static DateTime _fromUs(int64 microseconds, bool isUtc, int32 offset) {
    DateTime d = DateTime(0);
    d._us = microseconds;
    d._utc = isUtc;
    d._offset = offset;
    return d;
  }

  /* Constructs a UTC DateTime from calendar parts (Dart's DateTime.utc). */
  static DateTime utc(
    int64 year,
    int64 month = 1,
    int64 day = 1,
    int64 hour = 0,
    int64 minute = 0,
    int64 second = 0,
    int64 millisecond = 0,
    int64 microsecond = 0,
  ) {
    _Tm tm;
    tm.tm_sec = second as int32;
    tm.tm_min = minute as int32;
    tm.tm_hour = hour as int32;
    tm.tm_mday = day as int32;
    tm.tm_mon = (month - 1) as int32;
    tm.tm_year = (year - 1900) as int32;
    tm.tm_wday = 0;
    tm.tm_yday = 0;
    tm.tm_isdst = 0;
    #if _WIN32
    int64 secs = _os_mkgmtime(&tm);
    #else
    int64 secs = _os_timegm(&tm);
    #endif
    return DateTime._fromUs(
      secs * 1000000 + millisecond * 1000 + microsecond,
      true,
      0,
    );
  }

  /* The current date and time in the local time zone (Dart's DateTime.now). */
  @inline
  static DateTime now() {
    int64 secs = _os_time(null);
    return DateTime.fromMicrosecondsSinceEpoch(secs * 1000000, isUtc: false);
  }

  @inline
  static DateTime fromMicrosecondsSinceEpoch(
    int64 microseconds,
    {bool isUtc = false},
  ) {
    return DateTime._fromUs(
      microseconds,
      isUtc,
      isUtc ? 0 : DateTime.OFFSET_UNSET,
    );
  }

  @inline
  static DateTime fromMillisecondsSinceEpoch(
    int64 milliseconds,
    {bool isUtc = false},
  ) {
    return DateTime.fromMicrosecondsSinceEpoch(
      milliseconds * 1000,
      isUtc: isUtc,
    );
  }

  /* The calendar components in this DateTime's own zone. */
  _Tm _toTm() {
    _Tm tm;
    int64 secs = this._us / 1000000;
    /* A UTC value carrying a recorded offset (parsed or zoned) renders
     * the zone's wall time: UTC shifted by the offset. */
    if (this._utc && this._offset != DateTime.OFFSET_UNSET &&
        this._offset != 0) {
      secs = secs + this._offset;
    }
    #if _WIN32
    if (this._utc) {
      _os_gmtime_s(&tm, &secs);
    } else {
      _os_localtime_s(&tm, &secs);
    }
    #else
    if (this._utc) {
      _os_gmtime_r(&secs, &tm);
    } else {
      _os_localtime_r(&secs, &tm);
    }
    #endif
    return tm;
  }

  int32 year() {
    return this._toTm().tm_year + 1900;
  }

  int32 month() {
    return this._toTm().tm_mon + 1;
  }

  int32 day() {
    return this._toTm().tm_mday;
  }

  int32 hour() {
    return this._toTm().tm_hour;
  }

  int32 minute() {
    return this._toTm().tm_min;
  }

  int32 second() {
    return this._toTm().tm_sec;
  }

  /* The millisecond within the current second, 0..999. */
  int32 millisecond() {
    return ((this._us % 1000000) / 1000) as int32;
  }

  /* The microsecond within the current millisecond, 0..999. */
  int32 microsecond() {
    return (this._us % 1000) as int32;
  }

  /* Day of the week: 1 = Monday .. 7 = Sunday (Dart's weekday). */
  int32 weekday() {
    int32 w = this._toTm().tm_wday;
    return w == 0 ? 7 : w;
  }

  /* Day of the year, 1..366 (Dart's dayOfYear). */
  int32 dayOfYear() {
    return this._toTm().tm_yday + 1;
  }

  bool isUtc() {
    return this._utc;
  }

  /* The UTC offset in seconds east of UTC for this DateTime: 0 for UTC
   * values, the recorded offset for parsed/zoned ones, and the local
   * zone's offset at this instant otherwise. */
  int32 utcOffset() {
    if (this._utc) {
      return this._offset == DateTime.OFFSET_UNSET ? 0 : this._offset;
    }
    if (this._offset != DateTime.OFFSET_UNSET) {
      return this._offset;
    }
    #if _WIN32
    return 0;
    #else
    _Tm tm;
    int64 t = this._us / 1000000;
    _os_localtime_r(&t, &tm);
    return tm.tm_gmtoff as int32;
    #endif
  }

  /* This DateTime converted to the IANA zone 'zone' (e.g. "Europe/Madrid"),
   * keeping the same instant. The result is a UTC-based value carrying
   * the zone's UTC offset, so it renders with the zone's wall time and a
   * "+HH:MM" suffix (the system's zoneinfo database is consulted through
   * the TZ environment variable; see the _tz_* bindings above). On
   * Windows the value is returned unchanged. */
  DateTime inZone(String zone) {
    #if _WIN32
    return *this;
    #else
    int64 off = DateTime._offsetForZone(zone, this._us / 1000000);
    return DateTime._fromUs(this._us, true, off as int32);
    #endif
  }

  /* The UTC offset of 'zone' at the instant 'secs' (POSIX only). */
  static int64 _offsetForZone(String zone, int64 secs) {
    #if _WIN32
    return 0;
    #else
    uint8* saved = _tz_getenv("TZ");
    String savedStr = saved == null ? "" : String(saved);
    _tz_setenv("TZ", zone.c_str(), 1);
    _tz_tzset();
    _Tm tm;
    int64 t = secs;
    _os_localtime_r(&t, &tm);
    int64 off = tm.tm_gmtoff;
    if (savedStr.isEmpty()) {
      _tz_unsetenv("TZ");
    } else {
      _tz_setenv("TZ", savedStr.c_str(), 1);
    }
    _tz_tzset();
    return off;
    #endif
  }

  /* -- parsing -------------------------------------------------------- */

  /* Parses an ISO 8601 string and throws FormatException on malformed
   * input. Accepted forms: "YYYY-MM-DD", with optional "THH:MM",
   * "THH:MM:SS" and ".ffffff" fractional seconds (the separator may also
   * be a space), plus an optional trailing 'Z' or "+HH:MM"/"-HH:MM"
   * offset. With an explicit offset the result is a UTC DateTime whose
   * instant is shifted accordingly (like Dart). */
  static DateTime parse(String s) {
    DateTime d;
    if (!DateTime._tryParse(s, d)) {
      throw FormatException();
    }
    return d;
  }

  /* Non-throwing parse; false when 's' is not a valid ISO 8601 string. */
  static bool tryParse(String s, DateTime& out) {
    return DateTime._tryParse(s, out);
  }

  /* Reads up to 'maxDigits' digits at 'pos', advancing 'next'. Returns -1
   * when no digit is present. */
  static int64 _parseInt(const String& s, usize pos, usize maxDigits,
                         usize& next) {
    if (pos >= s.length()) return -1;
    int64 v = 0;
    usize n = 0;
    while (pos < s.length() && n < maxDigits) {
      uint8 c = s[pos];
      if (c < 48 || c > 57) break;
      v = v * 10 + (c - 48);
      pos++;
      n++;
    }
    next = pos;
    return n == 0 ? -1 : v;
  }

  static bool _tryParse(const String& s, DateTime& out) {
    usize i = 0;
    int64 year = DateTime._parseInt(s, 0, 4, i);
    if (year < 0 || i >= s.length() || s[i] != 0x2D) return false;
    i++;
    int64 month = DateTime._parseInt(s, i, 2, i);
    if (month < 1 || month > 12 || i >= s.length() || s[i] != 0x2D) {
      return false;
    }
    i++;
    int64 day = DateTime._parseInt(s, i, 2, i);
    if (day < 1 || day > 31) return false;
    int64 hour = 0;
    int64 minute = 0;
    int64 second = 0;
    int64 micro = 0;
    if (i < s.length()) {
      uint8 sep = s[i];
      if (sep != 0x54 && sep != 0x20) return false; /* 'T' or ' ' */
      i++;
      hour = DateTime._parseInt(s, i, 2, i);
      if (hour < 0 || hour > 23 || i >= s.length() || s[i] != 0x3A) {
        return false;
      }
      i++;
      minute = DateTime._parseInt(s, i, 2, i);
      if (minute < 0 || minute > 59) return false;
      if (i < s.length() && s[i] == 0x3A) {
        i++;
        second = DateTime._parseInt(s, i, 2, i);
        if (second < 0 || second > 59) return false;
        if (i < s.length() && s[i] == 0x2E) { /* '.' */
          i++;
          int64 frac = 0;
          int32 digits = 0;
          while (i < s.length() && digits < 6 && s[i] >= 48 && s[i] <= 57) {
            frac = frac * 10 + (s[i] - 48);
            digits++;
            i++;
          }
          if (digits == 0) return false;
          if (i < s.length() && s[i] >= 48 && s[i] <= 57) return false;
          while (digits < 6) {
            frac *= 10;
            digits++;
          }
          micro = frac;
        }
      }
    }
    int32 offsetSecs = 0;
    bool isUtc = false;
    if (i < s.length()) {
      uint8 c = s[i];
      if (c == 0x5A || c == 0x7A) { /* Z */
        isUtc = true;
        i++;
      } else if (c == 0x2B || c == 0x2D) { /* +/-HH:MM */
        bool neg = c == 0x2D;
        i++;
        int64 oh = DateTime._parseInt(s, i, 2, i);
        if (oh < 0 || oh > 23 || i >= s.length() || s[i] != 0x3A) {
          return false;
        }
        i++;
        int64 om = DateTime._parseInt(s, i, 2, i);
        if (om < 0 || om > 59) return false;
        int32 total = ((oh * 60 + om) * 60) as int32;
        offsetSecs = neg ? -total : total;
        isUtc = true;
      } else {
        return false;
      }
    }
    if (i != s.length()) return false;

    _Tm tm;
    tm.tm_sec = second as int32;
    tm.tm_min = minute as int32;
    tm.tm_hour = hour as int32;
    tm.tm_mday = day as int32;
    tm.tm_mon = (month - 1) as int32;
    tm.tm_year = (year - 1900) as int32;
    tm.tm_wday = 0;
    tm.tm_yday = 0;
    tm.tm_isdst = -1;
    int64 secs;
    if (isUtc) {
      #if _WIN32
      secs = _os_mkgmtime(&tm);
      #else
      secs = _os_timegm(&tm);
      #endif
      secs = secs - offsetSecs;
    } else {
      secs = _os_mktime(&tm);
    }
    out = DateTime._fromUs(
      secs * 1000000 + micro,
      isUtc,
      isUtc ? offsetSecs : DateTime.OFFSET_UNSET,
    );
    return true;
  }

  @inline
  int64 microsecondsSinceEpoch() {
    return this._us;
  }

  @inline
  int64 millisecondsSinceEpoch() {
    return this._us / 1000;
  }

  /* This minus 'other', as a Duration (Dart's difference). */
  @inline
  Duration difference(DateTime other) {
    return Duration.microseconds(this._us - other._us);
  }

  @inline
  DateTime add(Duration duration) {
    return DateTime.fromMicrosecondsSinceEpoch(
      this._us + duration.inMicroseconds(),
      isUtc: this._utc,
    );
  }

  @inline
  DateTime subtract(Duration duration) {
    return DateTime.fromMicrosecondsSinceEpoch(
      this._us - duration.inMicroseconds(),
      isUtc: this._utc,
    );
  }

  @inline
  bool isBefore(DateTime other) {
    return this._us < other._us;
  }

  @inline
  bool isAfter(DateTime other) {
    return this._us > other._us;
  }

  @inline
  bool isAtSameMomentAs(DateTime other) {
    return this._us == other._us;
  }

  /* Negative when this < other, zero when equal, positive otherwise. */
  int32 compareTo(DateTime other) {
    if (this._us < other._us) return -1;
    if (this._us > other._us) return 1;
    return 0;
  }

  @extern("snprintf")
  static int32 c_snprintf(uint8* str, usize size, const uint8* format, ...);

  static usize _strlen(const uint8* s) {
    usize n = 0;
    while (s[n] != 0) {
      n++;
    }
    return n;
  }

  /* Appends the zone suffix: "Z" for UTC, "+HH:MM"/"-HH:MM" for a known
   * offset, nothing for a plain local time. Returns the new length. */
  static usize _appendOffsetSuffix(uint8* buf, usize len, int32 offset) {
    if (offset == DateTime.OFFSET_UNSET) return len;
    if (offset == 0) {
      buf[len] = 0x5A; /* Z */
      return len + 1;
    }
    int32 abs = offset < 0 ? -offset : offset;
    buf[len] = offset < 0 ? 0x2D : 0x2B;
    len++;
    int32 hh = abs / 3600;
    int32 mm = (abs % 3600) / 60;
    buf[len] = (48 + hh / 10) as uint8;
    len++;
    buf[len] = (48 + hh % 10) as uint8;
    len++;
    buf[len] = 0x3A;
    len++;
    buf[len] = (48 + mm / 10) as uint8;
    len++;
    buf[len] = (48 + mm % 10) as uint8;
    len++;
    return len;
  }

  /* Local: "2024-01-15 10:30:00.000000"; UTC appends "Z", zoned values
   * append their "+HH:MM" offset. */
  String toString() {
    _Tm tm = this._toTm();
    uint8[72] buf;
    usize n = 0;
    DateTime.c_snprintf(
      &buf[0],
      72,
      "%04lld-%02lld-%02lld %02lld:%02lld:%02lld.%03lld%03lld",
      (tm.tm_year + 1900) as int64,
      (tm.tm_mon + 1) as int64,
      tm.tm_mday as int64,
      tm.tm_hour as int64,
      tm.tm_min as int64,
      tm.tm_sec as int64,
      this.millisecond() as int64,
      this.microsecond() as int64,
    );
    n = DateTime._strlen(&buf[0]);
    n = DateTime._appendOffsetSuffix(&buf[0], n, this._offset);
    buf[n] = 0;
    return &buf[0];
  }

  /* ISO 8601: "2024-01-15T10:30:00.000000"; UTC appends "Z", zoned
   * values append their "+HH:MM" offset. */
  String toIso8601String() {
    _Tm tm = this._toTm();
    uint8[72] buf;
    usize n = 0;
    DateTime.c_snprintf(
      &buf[0],
      72,
      "%04lld-%02lld-%02lldT%02lld:%02lld:%02lld.%03lld%03lld",
      (tm.tm_year + 1900) as int64,
      (tm.tm_mon + 1) as int64,
      tm.tm_mday as int64,
      tm.tm_hour as int64,
      tm.tm_min as int64,
      tm.tm_sec as int64,
      this.millisecond() as int64,
      this.microsecond() as int64,
    );
    n = DateTime._strlen(&buf[0]);
    n = DateTime._appendOffsetSuffix(&buf[0], n, this._offset);
    buf[n] = 0;
    return &buf[0];
  }
}
