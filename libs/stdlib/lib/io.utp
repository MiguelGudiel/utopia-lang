#if _WIN32

@extern("_access")
static int32 _access(const uint8* path, int32 mode);

@extern("_mkdir")
static int32 _mkdir(const uint8* path);

@extern("_rmdir")
static int32 _rmdir(const uint8* path);

@extern("GetModuleFileNameA")
static uint32 _GetModuleFileNameA(void* module, uint8* buf, uint32 size);

@extern("_getcwd")
static uint8* _getcwd(uint8* buf, int32 size);

#else

@extern("access")
static int32 _access(const uint8* path, int32 mode);

@extern("mkdir")
static int32 _mkdir(const uint8* path, int32 mode);

@extern("rmdir")
static int32 _rmdir(const uint8* path);

#if __APPLE__
@extern("_NSGetExecutablePath")
static int32 _NSGetExecutablePath(uint8* buf, uint32* bufsize);
#else
@extern("readlink")
static int64 _os_readlink(const uint8* path, uint8* buf, uint64 bufsize);
#endif

@extern("getcwd")
static uint8* _getcwd(uint8* buf, uint64 size);

#endif

@extern("fopen")
static void* _fopen(const uint8* filename, const uint8* mode);

@extern("fclose")
static int32 _fclose(void* stream);

@extern("fread")
static uint64 _fread(void* ptr, uint64 size, uint64 count, void* stream);

@extern("fwrite")
static uint64 _fwrite(const void* ptr, uint64 size, uint64 count, void* stream);

@extern("fseek")
static int32 _fseek(void* stream, int64 offset, int32 origin);

@extern("ftell")
static int64 _ftell(void* stream);

@extern("remove")
static int32 _remove(const uint8* filename);

@extern("rename")
static int32 _rename(const uint8* oldname, const uint8* newname);

class Path {
  static String getExecutablePath() {
    uint8[4096] exePath;
    #if _WIN32
    uint32 len = _GetModuleFileNameA(null, &exePath[0], 4096);
    if (len <= 0) return "";
    exePath[len] = 0;
    return &exePath[0];
    #else
    #if __APPLE__
    uint32 bufsize = 4096;
    if (_NSGetExecutablePath(&exePath[0], &bufsize) != 0) return "";
    return &exePath[0];
    #else
    int64 len = _os_readlink("/proc/self/exe", &exePath[0], 4096);
    if (len <= 0) return "";
    exePath[len] = 0;
    return &exePath[0];
    #endif
    #endif
  }

  static String getCurrentDirectory() {
    uint8[4096] buf;
    #if _WIN32
    uint8* res = _getcwd(&buf[0], 4096);
    #else
    uint8* res = _getcwd(&buf[0], 4096);
    #endif
    if (res == null) return "";
    return res;
  }

  static String getDirectoryName(String path) {
    int64 lastSlash = -1;
    uint64 len = path.length();
    for (uint64 i = 0; i < len; i++) {
      if (path[i] == 47 || path[i] == 92) {
        lastSlash = i as int64;
      }
    }
    if (lastSlash == -1) return "";
    
    String dir;
    for (int64 i = 0; i <= lastSlash; i++) {
      dir.push_back(path[i as uint64]);
    }
    return dir;
  }

  static String getFileName(String path) {
    int64 lastSlash = -1;
    uint64 len = path.length();
    for (uint64 i = 0; i < len; i++) {
      if (path[i] == 47 || path[i] == 92) {
        lastSlash = i as int64;
      }
    }
    
    String file;
    for (uint64 i = (lastSlash + 1) as uint64; i < len; i++) {
      file.push_back(path[i]);
    }
    return file;
  }

  static String combine(String path1, String path2) {
    if (path1.length() == 0) return path2;
    if (path2.length() == 0) return path1;
    
    uint8 lastChar = path1[path1.length() - 1];
    if (lastChar == 47 || lastChar == 92) {
      return path1 + path2;
    }
    #if _WIN32
    return path1 + "\\" + path2;
    #else
    return path1 + "/" + path2;
    #endif
  }
}

/*
 * Low-level API for granular file stream operations.
 * Wraps C-style file manipulation with automated resource management.
 */
class FileHandle {
  void* _handle;

  static const int32 SEEK_SET = 0;
  static const int32 SEEK_CUR = 1;
  static const int32 SEEK_END = 2;

  FileHandle() {
    this._handle = null;
  }

  ~FileHandle() {
    this.close();
  }

  bool open(String path, String mode) {
    this.close();
    this._handle = _fopen(path.c_str(), mode.c_str());
    return this._handle != null;
  }

  void close() {
    if (this._handle != null) {
      _fclose(this._handle);
      this._handle = null;
    }
  }

  @inline
  bool isOpen() => this._handle != null;

  uint64 read(uint8* buffer, uint64 size, uint64 count) {
    if (this._handle == null) return 0;
    return _fread(buffer, size, count, this._handle);
  }

  uint64 write(const uint8* buffer, uint64 size, uint64 count) {
    if (this._handle == null) return 0;
    return _fwrite(buffer, size, count, this._handle);
  }

  bool seek(int64 offset, int32 origin) {
    if (this._handle == null) return false;
    return _fseek(this._handle, offset, origin) == 0;
  }

  int64 tell() {
    if (this._handle == null) return -1;
    return _ftell(this._handle);
  }
}

/*
 * High-level API for File manipulations.
 */
class File {
  String _path;

  File(String path) {
    this._path = path;
  }

  @inline
  String getPath() => this._path;

  @inline
  bool exists() {
    return _access(this._path.c_str(), 0) == 0;
  }

  @inline
  bool remove() {
    return _remove(this._path.c_str()) == 0;
  }

  bool rename(String newPath) {
    bool success = _rename(this._path.c_str(), newPath.c_str()) == 0;
    if (success) {
      this._path = newPath;
    }
    return success;
  }

  /*
   * Copies the current file to the specified destination path.
   * Uses buffered binary streams to ensure memory safety.
   */
  bool copy(String destPath) {
    FileHandle src;
    if (!src.open(this._path, "rb")) return false;

    FileHandle dest;
    if (!dest.open(destPath, "wb")) return false;

    uint8[4096] buffer;
    while (true) {
      uint64 bytesRead = src.read(&buffer[0], 1, 4096);
      if (bytesRead == 0) break;
      dest.write(&buffer[0], 1, bytesRead);
    }
    
    return true;
  }

  /*
   * Moves the file to a new location.
   * Acts as a semantic alias to the underlying rename operation.
   */
  @inline
  bool move(String newPath) {
    return this.rename(newPath);
  }

  uint64 length() {
    void* file = _fopen(this._path.c_str(), "rb");
    if (file == null) return 0;
    _fseek(file, 0, 2);
    int64 size = _ftell(file);
    _fclose(file);
    
    if (size < 0) return 0;
    return size as uint64;
  }

  String readAsString() {
    void* file = _fopen(this._path.c_str(), "rb");
    if (file == null) return "";

    _fseek(file, 0, 2);
    int64 size = _ftell(file);
    _fseek(file, 0, 0);

    if (size <= 0) {
      _fclose(file);
      return "";
    }

    uint8* buffer = new uint8[size as uint64 + 1];
    uint64 readSize = _fread(buffer, 1, size as uint64, file);
    buffer[readSize] = 0;

    _fclose(file);

    String result = buffer;
    delete[] buffer;
    return result;
  }

  bool writeAsString(String content) {
    void* file = _fopen(this._path.c_str(), "wb");
    if (file == null) return false;

    uint64 written = _fwrite(content.c_str(), 1, content.length(), file);
    _fclose(file);
    return written == content.length();
  }

  bool appendAsString(String content) {
    void* file = _fopen(this._path.c_str(), "ab");
    if (file == null) return false;

    uint64 written = _fwrite(content.c_str(), 1, content.length(), file);
    _fclose(file);
    return written == content.length();
  }

  bool create() {
    if (this.exists()) return true;
    void* file = _fopen(this._path.c_str(), "wb");
    if (file == null) return false;
    _fclose(file);
    return true;
  }
}

/*
 * High-level API for Directory manipulations.
 */
class Directory {
  String _path;

  Directory(String path) {
    this._path = path;
  }

  @inline
  String getPath() => this._path;

  @inline
  bool exists() {
    return _access(this._path.c_str(), 0) == 0;
  }

  bool create() {
    #if _WIN32
    return _mkdir(this._path.c_str()) == 0;
    #else
    /* 0x1FF (hex) = 511 (dec) = 0777 (octal for POSIX) */
    return _mkdir(this._path.c_str(), 0x1FF) == 0;
    #endif
  }

  @inline
  bool remove() {
    return _rmdir(this._path.c_str()) == 0;
  }

  /*
   * Renames the directory to a new path.
   */
  bool rename(String newPath) {
    bool success = _rename(this._path.c_str(), newPath.c_str()) == 0;
    if (success) {
      this._path = newPath;
    }
    return success;
  }

  /*
   * Moves the directory to a new location.
   */
  @inline
  bool move(String newPath) {
    return this.rename(newPath);
  }

  /*
   * Recursively deletes the directory and all its contents.
   * Relies on standard OS shell commands for cross-platform execution.
   */
  bool deleteRecursive() {
    #if _WIN32
    String cmd = "rmdir /s /q \"" + this._path + "\"";
    #else
    String cmd = "rm -rf \"" + this._path + "\"";
    #endif
    return system(cmd.c_str()) == 0;
  }

  /*
   * Recursively copies the directory and all its contents to a new destination.
   */
  bool copy(String destPath) {
    #if _WIN32
    String cmd = "xcopy /E /I /Y /Q \"" + this._path + "\" \"" + destPath + "\"";
    #else
    String cmd = "cp -r \"" + this._path + "\" \"" + destPath + "\"";
    #endif
    return system(cmd.c_str()) == 0;
  }
}