/* Entry point for the SIMD layer: importing "utopia:simd" loads the
 * portable operations plus the backend-specific _mm/_mm256/_mm512 and
 * v*_q names. The files under simd/ are generated by
 * scripts/gen_simd_prelude.py; do not edit them by hand. */
export "simd/core.utp";
export "simd/x86.utp";
export "simd/neon.utp";
