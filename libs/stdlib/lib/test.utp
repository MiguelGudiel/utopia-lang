int sum(int a, int b) {
  return a+b;
}

float sum(float a, float b) {
  return a+b;
}

int sub(int a, int b) {
  return a-b;
}

float sub(float a, float b) {
  return a-b;
}

int mul(int a, int b) {
  return a*b;
}

float mul(float a, float b) {
  return a*b;
}

int div(int a, int b) {
  return a/b;
}

float div(float a, float b) {
  return a/b;
}