import "io.utp";

#if _WIN32

@extern("LoadLibraryA")
void* os_dlopen(const uint8* filename);

@extern("GetProcAddress")
void* os_dlsym(void* handle, const uint8* symbol);

@extern("FreeLibrary")
int32 os_dlclose(void* handle);

#else

@extern("dlopen")
void* os_dlopen(const uint8* filename, int32 flag);

@extern("dlsym")
void* os_dlsym(void* handle, const uint8* symbol);

@extern("dlclose")
int32 os_dlclose(void* handle);

#endif

class DynamicLibrary {
  void* handle;

  static DynamicLibrary* open(const uint8* libName) {
    #if _WIN32
    
    void* h = os_dlopen(libName);
    if (h != null) {
      DynamicLibrary* lib = new DynamicLibrary();
      lib.handle = h;
      return lib;
    }

    String exeDir = Path.getDirectoryName(Path.getExecutablePath());
    if (exeDir.length() == 0) return null;
    
    String libStr = libName;
    String finalPath = Path.combine(exeDir, libStr);

    void* handle2 = os_dlopen(finalPath.c_str());
    if (handle2 == null) return null;

    DynamicLibrary* lib2 = new DynamicLibrary();
    lib2.handle = handle2;
    return lib2;

    #else

    if (libName[0] == 47) {
      void* h = os_dlopen(libName, 2);
      if (h == null) return null;

      DynamicLibrary* lib = new DynamicLibrary();
      lib.handle = h;
      return lib;
    }

    String exeDir = Path.getDirectoryName(Path.getExecutablePath());
    if (exeDir.length() == 0) return null;
    
    String libStr = libName;
    String finalPath = Path.combine(exeDir, libStr);

    void* handle2 = os_dlopen(finalPath.c_str(), 2);
    if (handle2 == null) return null;

    DynamicLibrary* lib2 = new DynamicLibrary();
    lib2.handle = handle2;
    return lib2;

    #endif
  }

  T resolve<T>(const uint8* symName) {
    void* sym = os_dlsym(this.handle, symName);
    return sym as T;
  }

  void unload() {
    if (this.handle != null) {
      os_dlclose(this.handle);
      this.handle = null;
    }
  }
}