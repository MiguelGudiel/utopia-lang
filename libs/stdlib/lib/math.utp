/*
 * Math: mathematical constants and functions, mirroring the useful parts
 * of dart:math and <cmath>.
 */

/* The numeric limits constants (INT32_MAX, FLOAT64_MAX, ...) travel with
 * the math module: importing "utopia:math" makes both available. */
export "limits.utp";

@extern("sqrt")
float64 _c_sqrt(float64 x);

@extern("pow")
float64 _c_pow(float64 base, float64 exponent);

@extern("exp")
float64 _c_exp(float64 x);

@extern("log")
float64 _c_log(float64 x);

@extern("log10")
float64 _c_log10(float64 x);

@extern("log2")
float64 _c_log2(float64 x);

@extern("sin")
float64 _c_sin(float64 x);

@extern("cos")
float64 _c_cos(float64 x);

@extern("tan")
float64 _c_tan(float64 x);

@extern("asin")
float64 _c_asin(float64 x);

@extern("acos")
float64 _c_acos(float64 x);

@extern("atan")
float64 _c_atan(float64 x);

@extern("atan2")
float64 _c_atan2(float64 y, float64 x);

@extern("sinh")
float64 _c_sinh(float64 x);

@extern("cosh")
float64 _c_cosh(float64 x);

@extern("tanh")
float64 _c_tanh(float64 x);

@extern("floor")
float64 _c_floor(float64 x);

@extern("ceil")
float64 _c_ceil(float64 x);

@extern("round")
float64 _c_round(float64 x);

@extern("trunc")
float64 _c_trunc(float64 x);

@extern("fmod")
float64 _c_fmod(float64 x, float64 y);

@extern("hypot")
float64 _c_hypot(float64 x, float64 y);

@extern("fabs")
float64 _c_fabs(float64 x);

@extern("expm1")
float64 _c_expm1(float64 x);

@extern("log1p")
float64 _c_log1p(float64 x);

@extern("cbrt")
float64 _c_cbrt(float64 x);

@extern("erf")
float64 _c_erf(float64 x);

@extern("tgamma")
float64 _c_tgamma(float64 x);

@extern("copysign")
float64 _c_copysign(float64 x, float64 y);

@extern("frexp")
float64 _c_frexp(float64 x, int32* exp);


class Math {
  static const float64 PI = 3.14159265358979323846;
  static const float64 E = 2.71828182845904523536;
  static const float64 LN2 = 0.69314718055994530942;
  static const float64 LN10 = 2.30258509299404568402;
  static const float64 LOG2E = 1.44269504088896340736;
  static const float64 LOG10E = 0.43429448190325182765;
  static const float64 SQRT2 = 1.41421356237309504880;
  static const float64 SQRT1_2 = 0.70710678118654752440;
  static const float64 DEG2RAD = 0.01745329251994329577;
  static const float64 RAD2DEG = 57.29577951308232087680;

  @forceInline
  static float64 sqrt(float64 x) {
    return _c_sqrt(x);
  }

  @forceInline
  static float64 pow(float64 base, float64 exponent) {
    return _c_pow(base, exponent);
  }

  @forceInline
  static float64 exp(float64 x) {
    return _c_exp(x);
  }

  @forceInline
  static float64 log(float64 x) {
    return _c_log(x);
  }

  @forceInline
  static float64 log10(float64 x) {
    return _c_log10(x);
  }

  @forceInline
  static float64 log2(float64 x) {
    return _c_log2(x);
  }

  @forceInline
  static float64 sin(float64 x) {
    return _c_sin(x);
  }

  @forceInline
  static float64 cos(float64 x) {
    return _c_cos(x);
  }

  @forceInline
  static float64 tan(float64 x) {
    return _c_tan(x);
  }

  @forceInline
  static float64 asin(float64 x) {
    return _c_asin(x);
  }

  @forceInline
  static float64 acos(float64 x) {
    return _c_acos(x);
  }

  @forceInline
  static float64 atan(float64 x) {
    return _c_atan(x);
  }

  @forceInline
  static float64 atan2(float64 y, float64 x) {
    return _c_atan2(y, x);
  }

  @forceInline
  static float64 sinh(float64 x) {
    return _c_sinh(x);
  }

  @forceInline
  static float64 cosh(float64 x) {
    return _c_cosh(x);
  }

  @forceInline
  static float64 tanh(float64 x) {
    return _c_tanh(x);
  }

  @forceInline
  static float64 floor(float64 x) {
    return _c_floor(x);
  }

  @forceInline
  static float64 ceil(float64 x) {
    return _c_ceil(x);
  }

  @forceInline
  static float64 round(float64 x) {
    return _c_round(x);
  }

  @forceInline
  static float64 trunc(float64 x) {
    return _c_trunc(x);
  }

  /* Remainder of x / y, with the sign of x (Dart's '%' on doubles). */
  @forceInline
  static float64 fmod(float64 x, float64 y) {
    return _c_fmod(x, y);
  }

  @forceInline
  static float64 hypot(float64 x, float64 y) {
    return _c_hypot(x, y);
  }

  @forceInline
  static float64 abs(float64 x) {
    return _c_fabs(x);
  }

  @forceInline
  static int64 abs(int64 x) {
    return x < 0 ? -x : x;
  }

  @forceInline
  static float64 min(float64 a, float64 b) {
    return a < b ? a : b;
  }

  @forceInline
  static float64 max(float64 a, float64 b) {
    return a > b ? a : b;
  }

  /* exp(x) - 1, accurate for x near zero (avoids the cancellation of
   * exp(x) - 1). */
  @forceInline
  static float64 expm1(float64 x) {
    return _c_expm1(x);
  }

  /* ln(1 + x), accurate for x near zero. */
  @forceInline
  static float64 log1p(float64 x) {
    return _c_log1p(x);
  }

  @forceInline
  static float64 cbrt(float64 x) {
    return _c_cbrt(x);
  }

  /* The Gauss error function. */
  @forceInline
  static float64 erf(float64 x) {
    return _c_erf(x);
  }

  /* The gamma function (factorial extended to the reals; poles at the
   * non-positive integers). */
  @forceInline
  static float64 tgamma(float64 x) {
    return _c_tgamma(x);
  }

  /* A float with the magnitude of 'x' and the sign of 'y'. */
  @forceInline
  static float64 copysign(float64 x, float64 y) {
    return _c_copysign(x, y);
  }

  /* Splits 'x' into a mantissa in [0.5, 1) and an integer exponent such
   * that x == mantissa * 2^exponent; 'exp' receives the exponent. */
  @forceInline
  static float64 frexp(float64 x, int32& exp) {
    return _c_frexp(x, &exp);
  }

  /* ------------------------------------------------------------------ */
  /* Statistics over numeric lists (population semantics).              */
  /* ------------------------------------------------------------------ */

  /* Arithmetic mean of the elements; 0.0 for an empty list. */
  static float64 mean<T>(List<T> data) {
    if (data.length() == 0) return 0.0;
    float64 sum = 0.0;
    for (usize i = 0; i < data.length(); i++) {
      sum += data[i] as float64;
    }
    return sum / (data.length() as float64);
  }

  /* Population variance: the mean of the squared deviations from the
   * mean (divides by n). 0.0 for an empty list. */
  static float64 variance<T>(List<T> data) {
    if (data.length() == 0) return 0.0;
    float64 m = Math.mean(data);
    float64 sum = 0.0;
    for (usize i = 0; i < data.length(); i++) {
      float64 d = (data[i] as float64) - m;
      sum += d * d;
    }
    return sum / (data.length() as float64);
  }

  /* Population standard deviation: sqrt(variance). */
  static float64 stddev<T>(List<T> data) {
    return Math.sqrt(Math.variance(data));
  }

  /* The middle value of a sorted copy of the data: the element at n / 2
   * for odd lengths, the mean of the two middle elements for even ones.
   * 0.0 for an empty list. Requires operator< on T (numbers, String, ...). */
  static float64 median<T>(List<T> data) {
    if (data.length() == 0) return 0.0;
    List<T> sorted;
    sorted.addAll(data);
    sorted.sort();
    usize n = sorted.length();
    if (n % 2 == 1) {
      return sorted[n / 2] as float64;
    }
    return ((sorted[n / 2 - 1] as float64) + (sorted[n / 2] as float64)) / 2.0;
  }
}

